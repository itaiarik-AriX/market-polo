---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Enquire from '../components/Enquire.astro';
import Cursor from '../components/Cursor.astro';

const YEAR = new Date().getFullYear();
const EMAIL = 'itaiarik@gmail.com';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content="Coruña Campervan — classic campervans, built, renovated, and ready to hire on the Galician coast." />
  <meta name="theme-color" content="#0b0c0d" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#f5f1e8" media="(prefers-color-scheme: light)" />
  <title>Coruña Campervan — hire the dream, or build your own</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/logo-light.webp" />
  <link rel="mask-icon" href="/favicon.svg" color="#c9a961" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;1,9..144,400;1,9..144,500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <Cursor />
  <Header />
  <main>
    <Hero />
    <Enquire />
  </main>
  <footer>
    <div>
      © {YEAR} Coruña Campervan
      <span class="dot">·</span>
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
    </div>
  </footer>

  <style>
    footer {
      position: relative;
      z-index: 10;
      background: var(--bg);
      border-top: 1px solid var(--rule);
      padding: 2rem 2rem calc(2rem + env(safe-area-inset-bottom, 0px));
      text-align: center;
      font-size: 0.85rem;
      color: var(--fg-dim);
    }
    footer a:hover {
      color: var(--accent);
    }
    footer .dot {
      color: var(--rule-strong);
      margin: 0 0.6rem;
    }
  </style>
</body>
</html>
