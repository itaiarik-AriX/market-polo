---
import { EMAIL } from '../lib/site';

// Build's page while the conversions side isn't live. No photo — the hire
// footage is of the finished van, which says the wrong thing here — so this
// is the hire palette carrying a line-art illustration instead: a van drawn
// only up to where the work has actually got to. Hero.astro hides its scrub
// track in Build so this section is the whole of the page.
---
<section class="building" id="building" data-building-section hidden>
  <div class="building-inner">
    <div class="illustration" aria-hidden="true">
      <svg viewBox="0 0 600 300" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="bFadeSolid" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="var(--fg)" stop-opacity="0.92"/>
            <stop offset="55%" stop-color="var(--fg)" stop-opacity="0.75"/>
            <stop offset="85%" stop-color="var(--fg)" stop-opacity="0.28"/>
            <stop offset="100%" stop-color="var(--fg)" stop-opacity="0"/>
          </linearGradient>
          <linearGradient id="bFadeDash" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="var(--fg)" stop-opacity="0.55"/>
            <stop offset="70%" stop-color="var(--fg)" stop-opacity="0.22"/>
            <stop offset="100%" stop-color="var(--fg)" stop-opacity="0"/>
          </linearGradient>
        </defs>

        <path d="M 40 195 L 40 150 Q 40 130 62 122 L 150 100 Q 168 96 186 96 L 300 96"
              stroke="url(#bFadeSolid)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M 300 96 L 470 96 Q 500 96 500 126 L 500 195"
              stroke="url(#bFadeDash)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
              stroke-dasharray="7 7"/>

        <path d="M 40 195 L 500 195" stroke="url(#bFadeDash)" stroke-width="2" stroke-dasharray="7 7"/>
        <circle cx="118" cy="197" r="24" stroke="var(--fg)" stroke-opacity="0.85" stroke-width="2.5"/>
        <circle cx="118" cy="197" r="9" stroke="var(--fg)" stroke-opacity="0.6" stroke-width="1.5"/>
        <circle cx="392" cy="197" r="24" stroke="var(--fg)" stroke-opacity="0.35" stroke-width="2.5" stroke-dasharray="4 5"/>
        <circle cx="392" cy="197" r="9" stroke="var(--fg)" stroke-opacity="0.22" stroke-width="1.5" stroke-dasharray="3 4"/>

        <path d="M 62 122 L 96 122 L 108 100" stroke="var(--fg)" stroke-opacity="0.7" stroke-width="1.6"/>

        <g stroke="var(--fg)" stroke-opacity="0.5" stroke-width="1.3">
          <rect x="330" y="150" width="120" height="18" stroke-dasharray="3 4" opacity="0.6"/>
          <rect x="150" y="150" width="46" height="45" opacity="0.65"/>
          <line x1="150" y1="165" x2="196" y2="165" opacity="0.5"/>
          <rect x="210" y="130" width="34" height="65" opacity="0.55" stroke-dasharray="3 4"/>
        </g>

        <g stroke="var(--accent)" stroke-width="1.2" opacity="0.85">
          <line x1="40" y1="225" x2="300" y2="225"/>
          <line x1="40" y1="219" x2="40" y2="231"/>
          <line x1="300" y1="219" x2="300" y2="231"/>
        </g>
        <line x1="300" y1="225" x2="500" y2="225" stroke="var(--accent)" stroke-width="1.2" opacity="0.3" stroke-dasharray="4 5"/>
      </svg>
    </div>

    <p class="eyebrow" data-label-en="UNDER CONSTRUCTION" data-label-es="EN CONSTRUCCIÓN">UNDER CONSTRUCTION</p>

    <h1 class="serif building-title"
      data-label-en="Still in the workshop."
      data-label-es="Todavía en el taller."
    >Still in the workshop.</h1>
    <span class="building-rule" aria-hidden="true"></span>

    <p class="building-body"
      data-label-en="The conversions side is being built. If you have got a van and an idea, write to us anyway — we are still taking projects."
      data-label-es="La parte de camperizaciones está en obras. Si tienes una furgo y una idea, escríbenos igualmente: seguimos cogiendo proyectos."
    >The conversions side is being built. If you have got a van and an idea, write to us anyway — we are still taking projects.</p>

    <div class="building-actions">
      <a class="building-btn" href={`mailto:${EMAIL}`}
        data-label-en="Write to us" data-label-es="Escríbenos"
      >Write to us</a>
      <button type="button" class="building-back" data-building-back
        data-label-en="See the vans for hire" data-label-es="Ver las furgos en alquiler"
      >See the vans for hire</button>
    </div>
  </div>

  <div class="building-brand">
    <img
      class="building-brand-shadow building-brand-shadow--ambient"
      src="/logo-glow.webp"
      alt=""
      aria-hidden="true"
      width="845"
      height="824"
      loading="lazy"
      decoding="async"
    />
    <img
      class="building-brand-shadow building-brand-shadow--contact"
      src="/logo-glow.webp"
      alt=""
      aria-hidden="true"
      width="845"
      height="824"
      loading="lazy"
      decoding="async"
    />
    <img
      class="building-brand-mark"
      src="/logo-light.webp"
      alt="MOUNTAIN-VAN"
      width="548"
      height="534"
      loading="lazy"
      decoding="async"
    />
  </div>
</section>

<style>
  .building {
    position: relative;
    z-index: 10;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 8vh 6vw calc(8vh + env(safe-area-inset-bottom, 0));
    background:
      radial-gradient(ellipse 60% 45% at 50% 42%, rgba(224, 137, 79, 0.16), transparent 70%),
      linear-gradient(180deg, var(--bg) 0%, var(--bg-soft) 100%);
  }
  .building[hidden] {
    display: none;
  }
  .building-inner {
    max-width: 640px;
  }

  .illustration {
    width: min(560px, 78vw);
    margin: 0 auto 3.2vh;
  }
  .illustration svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .building-title {
    font-weight: 400;
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  .building-rule {
    display: block;
    width: clamp(120px, 18%, 190px);
    height: 1px;
    margin: 1.1rem auto 0;
    background: var(--accent);
    opacity: 0.85;
  }
  .building-body {
    margin-top: 1rem;
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    color: var(--fg-dim);
  }

  .building-actions {
    margin-top: 2.1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .building-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: var(--accent);
    color: #1a1206;
    border-radius: 999px;
    font-weight: 500;
    font-size: 1rem;
    padding: 0.9rem 2rem;
    min-height: 50px;
    transition: background 0.25s ease, transform 0.25s ease;
  }
  .building-btn:hover {
    background: var(--accent-deep);
    transform: translateY(-1px);
  }
  .building-back {
    background: none;
    border: none;
    font: inherit;
    color: var(--fg-dim);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-size: 0.92rem;
    cursor: pointer;
    padding: 0.4rem;
  }
  .building-back:hover {
    color: var(--fg);
  }

  @media (max-width: 640px) {
    .illustration { margin-bottom: 2.4vh; }
    .building-actions { margin-top: 1.7rem; }
  }

  /* Same two-layer contact/ambient shadow treatment as Hero's badge, so it
     reads as one object sitting on the page rather than a flat sticker. */
  .building-brand {
    position: absolute;
    right: 4vw;
    bottom: 4vh;
    height: clamp(84px, 13.5vh, 160px);
    aspect-ratio: 548 / 534;
    pointer-events: none;
  }
  .building-brand-shadow {
    position: absolute;
    left: 50%;
    top: 50%;
    height: auto;
    mix-blend-mode: multiply;
  }
  .building-brand-shadow--ambient {
    width: 168%;
    transform: translate(calc(-50% + 2.5%), calc(-50% + 7%));
    opacity: 0.5;
  }
  .building-brand-shadow--contact {
    width: 116%;
    transform: translate(calc(-50% + 1%), calc(-50% + 3%));
    opacity: 0.62;
  }
  .building-brand-mark {
    position: relative;
    display: block;
    height: 100%;
    width: auto;
    opacity: 0.95;
  }
  @media (max-width: 640px) {
    .building-brand {
      height: clamp(66px, 10vh, 104px);
      right: 5vw;
      bottom: 3vh;
    }
  }
</style>

<script>
  function initBuilding() {
    const section = document.querySelector<HTMLElement>('[data-building-section]');
    if (!section) return;

    function applyLang(lang: string) {
      const key = lang === 'es' ? 'labelEs' : 'labelEn';
      section!.querySelectorAll<HTMLElement>('[data-label-en]').forEach((el) => {
        const text = el.dataset[key];
        if (text) el.innerHTML = text;
      });
    }

    function applyMode(mode: string) {
      section!.hidden = mode !== 'build';
    }

    document.addEventListener('mode-change', (e: Event) => {
      applyMode((e as CustomEvent).detail.mode);
    });
    document.addEventListener('language-change', (e: Event) => {
      applyLang((e as CustomEvent).detail.lang);
    });

    const back = section.querySelector<HTMLButtonElement>('[data-building-back]');
    back?.addEventListener('click', () => {
      const hireBtn = document.querySelector<HTMLButtonElement>('[data-mode-btn="hire"]');
      hireBtn?.click();
    });

    applyLang(localStorage.getItem('lang') || 'en');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBuilding);
  } else {
    initBuilding();
  }
</script>
