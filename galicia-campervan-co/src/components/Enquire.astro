---
import { EMAIL } from '../lib/site';

// Build-only now. The hire panel — booking CTA and hire enquiry form — moved
// into the fleet gallery overlay (Fleet.astro), so a visitor picks a van before
// asking about it. BOOKING_URL moved to src/lib/site.ts, which is also what
// Header.astro reads.
---
<section class="enquire" id="enquire" data-enquire-section hidden>
  <div class="enquire-inner">
    <p class="eyebrow" data-enquire-eyebrow data-label-en="— Enquire" data-label-es="— Contacto">— Enquire</p>

    {/* Hire has no panel here any more: booking and the hire enquiry form both
        moved into the fleet gallery overlay, so you pick a van before you ask
        about it. See Fleet.astro. This section is Build-only now, and hides
        itself entirely in Hire. */}
    <div data-enquire-panel="build" hidden>
      <h2 class="serif" data-label-en="Tell us about your build." data-label-es="Cuéntanos tu proyecto.">Tell us about your build.</h2>
      <p class="lede"
        data-label-en="A bare panel van, or a camper that's seen better decades. Tell us where you're starting and we'll write back."
        data-label-es="Una furgoneta vacía o una camper que ha visto décadas mejores. Cuéntanos de dónde partes y te contestamos."
      >A bare panel van, or a camper that's seen better decades. Tell us where you're starting and we'll write back.</p>
      <form class="enquiry-form" data-enquiry-form="build">
        <label>
          <span data-label-en="Your name" data-label-es="Tu nombre">Your name</span>
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <label>
          <span data-label-en="What are you starting with?" data-label-es="¿Con qué empiezas?">What are you starting with?</span>
          <input type="text" name="base" required
            data-ph-en="e.g. a 2019 Transporter, an old T2 that needs love…"
            data-ph-es="p. ej. una Transporter de 2019, una T2 vieja que pide cariño…"
            placeholder="e.g. a 2019 Transporter, an old T2 that needs love…" />
        </label>
        <label>
          <span data-label-en="What do you have in mind?" data-label-es="¿Qué tienes en mente?">What do you have in mind?</span> <span class="optional" data-label-en="(optional)" data-label-es="(opcional)">(optional)</span>
          <textarea name="notes" rows="3"
            data-ph-en="Full conversion, renovation, something in between…"
            data-ph-es="Camperización completa, reforma, algo intermedio…"
            placeholder="Full conversion, renovation, something in between…"></textarea>
        </label>
        <button type="submit" class="submit-btn"
          data-label-en="Start the conversation &rarr;" data-label-es="Empecemos a hablar &rarr;"
        >Start the conversation &rarr;</button>
      </form>
    </div>
  </div>
</section>

<style>
  .enquire {
    position: relative;
    z-index: 10;
    background: var(--bg);
    border-top: 1px solid var(--rule);
    padding: 7rem 2rem calc(7rem + env(safe-area-inset-bottom, 0));
  }
  .enquire-inner {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }
  .enquire h2 {
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 1.25rem 0 1rem;
  }
  .lede {
    color: var(--fg-dim);
    font-size: 1.05rem;
    margin-bottom: 2.5rem;
  }
  .enquiry-form {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    text-align: left;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--fg-dim);
  }
  .optional {
    opacity: 0.6;
  }
  input,
  textarea {
    background: var(--bg-soft);
    border: 1px solid var(--rule);
    border-radius: 8px;
    color: var(--fg);
    font: inherit;
    font-size: 1rem;
    padding: 0.8rem 1rem;
    transition: border-color 0.25s ease;
    color-scheme: dark;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--accent);
  }
  /* Build's form IS the primary action here, so it keeps the solid treatment. */
  .submit-btn {
    margin-top: 0.5rem;
    align-self: center;
    background: var(--accent);
    color: #1a1206;
    border: none;
    border-radius: 999px;
    font: inherit;
    font-weight: 500;
    font-size: 1rem;
    padding: 0.9rem 2.2rem;
    min-height: 48px;
    cursor: pointer;
    transition: background 0.25s ease, border-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }
  .submit-btn:hover {
    background: var(--accent-deep);
    transform: translateY(-1px);
  }
  @media (max-width: 640px) {
    .enquire {
      padding: 5rem 1.25rem calc(5rem + env(safe-area-inset-bottom, 0));
    }
  }
</style>

<script define:vars={{ EMAIL }}>
  // Compose a pre-filled mailto enquiry — no backend needed.
  // Build only: the hire equivalent lives in Fleet.astro's gallery overlay, so
  // that a hire enquiry can name the van it is about.
  function initEnquiry() {
    const section = document.querySelector('[data-enquire-section]');
    let currentLang = localStorage.getItem('lang') || 'en';

    const emailStrings = {
      en: {
        subject: 'Build enquiry',
        greeting: 'Hi MOUNTAIN-VAN,',
        intro: "We've got a van and an idea.",
        name: 'Name',
        base: 'Starting point',
        more: 'What I have in mind',
      },
    };
    emailStrings.es = {
      subject: 'Consulta de camperización',
      greeting: 'Hola MOUNTAIN-VAN:',
      intro: 'Tenemos una furgoneta y una idea.',
      name: 'Nombre',
      base: 'Punto de partida',
      more: 'Lo que tengo en mente',
    };

    // Swap every visible string in this section. Labels and placeholders each
    // carry both languages inline, so this needs no re-render.
    function applyLang(lang) {
      const key = lang === 'es' ? 'labelEs' : 'labelEn';
      const phKey = lang === 'es' ? 'phEs' : 'phEn';
      if (!section) return;
      section.querySelectorAll('[data-label-en]').forEach((el) => {
        const text = el.dataset[key];
        if (text) el.innerHTML = text;
      });
      section.querySelectorAll('[data-ph-en]').forEach((el) => {
        const text = el.dataset[phKey];
        if (text) el.setAttribute('placeholder', text);
      });
    }

    // The whole section is Build's now — in Hire the fleet takes its place.
    function applyMode(mode) {
      if (section) section.hidden = mode !== 'build';
      document.querySelectorAll('[data-enquire-panel]').forEach((panel) => {
        panel.hidden = panel.dataset.enquirePanel !== mode;
      });
    }

    document.addEventListener('mode-change', (e) => applyMode(e.detail.mode));
    document.addEventListener('language-change', (e) => {
      currentLang = e.detail.lang;
      applyLang(currentLang);
    });

    document.querySelectorAll('[data-enquiry-form]').forEach((form) => {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const s = emailStrings[currentLang] || emailStrings.en;
        const subject = `${s.subject} from ${data.get('name')}`;
        const lines = [
          s.greeting,
          '',
          s.intro,
          '',
          `${s.name}: ${data.get('name')}`,
          `${s.base}: ${data.get('base')}`,
          data.get('notes') ? `\n${s.more}:\n${data.get('notes')}` : '',
        ];
        window.location.href = `mailto:${EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
      });
    });

    applyMode('hire');
    applyLang(currentLang);
  }

  initEnquiry();
</script>
