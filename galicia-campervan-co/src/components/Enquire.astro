---
const EMAIL = 'itaiarik@gmail.com';
---
<section class="enquire" id="enquire">
  <div class="enquire-inner">
    <p class="eyebrow" data-enquire-eyebrow>— Enquire</p>

    <div data-enquire-panel="hire">
      <h2 class="serif">Request your dates.</h2>
      <p class="lede">No booking engine, no card details — tell us when and we'll write back personally, usually the same day.</p>
      <form class="enquiry-form" data-enquiry-form="hire">
        <div class="field-row">
          <label>
            From
            <input type="date" name="from" required />
          </label>
          <label>
            To
            <input type="date" name="to" required />
          </label>
        </div>
        <label>
          Your name
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <label>
          Anything we should know? <span class="optional">(optional)</span>
          <textarea name="notes" rows="3" placeholder="Where you're dreaming of going, how many of you…"></textarea>
        </label>
        <button type="submit" class="submit-btn">Send enquiry &rarr;</button>
      </form>
    </div>

    <div data-enquire-panel="build" hidden>
      <h2 class="serif">Tell us about your build.</h2>
      <p class="lede">Whether it's a bare van or a tired camper that needs a new life — start the conversation and we'll reply personally.</p>
      <form class="enquiry-form" data-enquiry-form="build">
        <label>
          Your name
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <label>
          What are you starting with?
          <input type="text" name="base" placeholder="e.g. a 2019 Transporter, an old T2 that needs love…" required />
        </label>
        <label>
          What do you have in mind? <span class="optional">(optional)</span>
          <textarea name="notes" rows="3" placeholder="Full conversion, renovation, something in between…"></textarea>
        </label>
        <button type="submit" class="submit-btn">Start the conversation &rarr;</button>
      </form>
    </div>
  </div>
</section>

<style>
  .enquire {
    position: relative;
    z-index: 10;
    background: var(--bg);
    border-top: 1px solid var(--rule);
    padding: 7rem 2rem calc(7rem + env(safe-area-inset-bottom, 0));
  }
  .enquire-inner {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }
  .enquire h2 {
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 1.25rem 0 1rem;
  }
  .lede {
    color: var(--fg-dim);
    font-size: 1.05rem;
    margin-bottom: 2.5rem;
  }
  .enquiry-form {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    text-align: left;
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--fg-dim);
  }
  .optional {
    opacity: 0.6;
  }
  input,
  textarea {
    background: var(--bg-soft);
    border: 1px solid var(--rule);
    border-radius: 8px;
    color: var(--fg);
    font: inherit;
    font-size: 1rem;
    padding: 0.8rem 1rem;
    transition: border-color 0.25s ease;
    color-scheme: dark;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--accent);
  }
  .submit-btn {
    margin-top: 0.5rem;
    align-self: center;
    background: var(--accent);
    color: #1a1206;
    border: none;
    border-radius: 999px;
    font: inherit;
    font-weight: 500;
    font-size: 1rem;
    padding: 0.9rem 2.2rem;
    min-height: 48px;
    cursor: pointer;
    transition: background 0.25s ease, transform 0.25s ease;
  }
  .submit-btn:hover {
    background: var(--accent-deep);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .enquire {
      padding: 5rem 1.25rem calc(5rem + env(safe-area-inset-bottom, 0));
    }
    .field-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script define:vars={{ EMAIL }}>
  // Compose a pre-filled mailto enquiry — no backend needed.
  function initEnquiry() {
    document.addEventListener('mode-change', (e) => {
      const { mode } = e.detail;
      document.querySelectorAll('[data-enquire-panel]').forEach((panel) => {
        panel.hidden = panel.dataset.enquirePanel !== mode;
      });
    });

    document.querySelectorAll('[data-enquiry-form]').forEach((form) => {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const mode = form.dataset.enquiryForm;
        const data = new FormData(form);
        let subject, lines;
        if (mode === 'hire') {
          subject = `Hire enquiry — ${data.get('from')} to ${data.get('to')}`;
          lines = [
            `Hi Coruña Campervan,`,
            ``,
            `I'd like to enquire about hiring the campervan.`,
            ``,
            `Dates: ${data.get('from')} → ${data.get('to')}`,
            `Name: ${data.get('name')}`,
            data.get('notes') ? `\nA bit more about the trip:\n${data.get('notes')}` : '',
          ];
        } else {
          subject = `Build enquiry from ${data.get('name')}`;
          lines = [
            `Hi Coruña Campervan,`,
            ``,
            `I'd like to talk about a build.`,
            ``,
            `Name: ${data.get('name')}`,
            `Starting point: ${data.get('base')}`,
            data.get('notes') ? `\nWhat I have in mind:\n${data.get('notes')}` : '',
          ];
        }
        const href = `mailto:${EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
        window.location.href = href;
      });
    });
  }

  initEnquiry();
</script>
