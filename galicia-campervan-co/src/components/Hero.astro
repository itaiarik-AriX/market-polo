---
import { timelines } from '../lib/heroTimeline';

// Build the list of high-res station stills (only for modes that provide them).
const stationStills = Object.entries(timelines).flatMap(([mode, tl]) =>
  tl.stationsBase
    ? tl.sections.map((s) => ({
        mode,
        id: s.id,
        src: `${tl.stationsBase}${s.id}.${tl.stationsExt ?? 'webp'}`,
      }))
    : []
);

// Copy is keyed by station id (see src/lib/heroTimeline.ts). Wording is a
// first draft — easy to refine once real van specifics are settled.
const copy = {
  hire: {
    welcome: {
      eyebrow: 'Galicia Campervan Co',
      title: 'Wake up somewhere the map forgot.',
      body: 'A classic camper, the open coast, and nowhere you have to be.',
    },
    exterior: {
      eyebrow: 'The van',
      title: 'A classic, through and through.',
      body: 'Restored, road-ready, and unmistakably retro — inside and out.',
    },
    amenities: {
      eyebrow: 'What’s inside',
      title: 'Everything you need for the road.',
      body: 'A proper bed, a hot side shower, and a full kitchen — all in reach.',
    },
    view: {
      eyebrow: 'Pull over anywhere',
      title: 'Wherever you stop, that’s the view.',
      body: 'No campsite required — just a spot you like the look of.',
    },
    closing: {
      eyebrow: 'Ready?',
      title: 'Ready to hit the road?',
      body: 'Tell us your dates below — we’ll write back personally.',
    },
  },
  build: {
    welcome: {
      eyebrow: 'Galicia Campervan Co',
      title: 'Every camper starts as steel and imagination.',
      body: 'This is where your build begins.',
    },
    engineering: {
      eyebrow: 'Engineering',
      title: 'Engineered underneath.',
      body: 'Insulation, electrics and systems done properly — so nothing lets you down.',
    },
    joinery: {
      eyebrow: 'Craftsmanship',
      title: 'Bespoke joinery, built by hand.',
      body: 'Every cabinet fitted to your van, not a generic kit.',
    },
    finish: {
      eyebrow: 'The finish',
      title: 'Finished to live in, not just to look at.',
      body: 'A complete build, ready for the road.',
    },
    closing: {
      eyebrow: 'Ready?',
      title: 'Ready to build yours?',
      body: 'Tell us what you have in mind below.',
    },
  },
};
---
<section class="hero-track" id="top" data-hero-track>
  <div class="hero-stage" data-hero-stage>
    <canvas data-hero-canvas aria-hidden="true"></canvas>

    <div class="hero-stills" aria-hidden="true">
      {stationStills.map((st) => (
        <img
          class="station-still"
          data-still-mode={st.mode}
          data-still-id={st.id}
          src={st.src}
          alt=""
          loading="eager"
          decoding="async"
        />
      ))}
    </div>

    <div class="hero-vignette" aria-hidden="true"></div>

    <div class="hero-copy">
      {Object.entries(copy).map(([mode, sections]) => (
        Object.entries(sections).map(([id, block]) => (
          <div class="copy-block" data-copy-mode={mode} data-copy-id={id}>
            <p class="eyebrow">{block.eyebrow}</p>
            <h2 class="serif copy-title">{block.title}</h2>
            <p class="copy-body">{block.body}</p>
          </div>
        ))
      ))}
    </div>

    <div class="scroll-cue" data-scroll-cue aria-hidden="true">
      <span></span>
      Scroll
    </div>

    <pre class="debug-readout" data-debug-readout aria-hidden="true" hidden></pre>
  </div>
</section>

<style>
  .hero-track {
    position: relative;
    height: 900vh; /* total scroll distance; more = slower, more cinematic scrub */
  }
  .hero-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    background: var(--bg);
  }
  .hero-stage canvas {
    position: absolute;
    inset: 0;
    display: block;
  }
  .hero-stills {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .station-still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    will-change: opacity;
  }
  .hero-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.42) 0%, rgba(0, 0, 0, 0) 26%, rgba(0, 0, 0, 0) 58%, rgba(0, 0, 0, 0.62) 100%);
    pointer-events: none;
  }

  .hero-copy {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .copy-block {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12vh;
    padding: 0 2rem;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    opacity: 0;
    transform: translateY(18px);
    will-change: opacity, transform;
  }
  .copy-block .eyebrow {
    margin-bottom: 0.9rem;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.7);
  }
  .copy-title {
    font-weight: 400;
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--fg);
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.6);
  }
  .copy-body {
    margin-top: 1rem;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    color: var(--fg);
    opacity: 0.92;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.7);
  }

  .scroll-cue {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-dim);
    transition: opacity 0.4s ease;
  }
  .scroll-cue span {
    width: 1px;
    height: 32px;
    background: linear-gradient(180deg, var(--fg-dim), transparent);
    animation: scroll-cue-move 1.8s ease-in-out infinite;
  }
  @keyframes scroll-cue-move {
    0% { transform: scaleY(0.3); opacity: 0.3; }
    50% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(0.3); opacity: 0.3; }
  }

  @media (max-width: 640px) {
    .copy-block { bottom: 14vh; }
  }

  /* Temporary diagnostic readout, opt-in only via ?debug=1 — never shown to a
     real visitor. Remove once no longer needed. */
  .debug-readout {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 20;
    margin: 0;
    padding: 0.6rem 0.8rem;
    background: rgba(0, 0, 0, 0.75);
    color: #7CFC9A;
    font-size: 0.72rem;
    line-height: 1.5;
    border-radius: 6px;
    pointer-events: none;
    white-space: pre;
  }
</style>

<script>
  import { createScrollScrubber } from '../lib/scrollScrubber';
  import { timelines } from '../lib/heroTimeline';
  import type { SectionRange } from '../lib/heroTimeline';

  function initHero() {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    const track = document.querySelector<HTMLElement>('[data-hero-track]');
    const scrollCue = document.querySelector<HTMLElement>('[data-scroll-cue]');
    const blocks = Array.from(document.querySelectorAll<HTMLElement>('.copy-block'));
    const stills = Array.from(document.querySelectorAll<HTMLElement>('.station-still'));
    if (!canvas || !track) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Fade a section's copy/still in over the first slice of its hold and out over the last.
    const EDGE = 0.28; // fraction of each hold used for the fade in/out

    function opacityForRange(p: number, start: number, end: number): number {
      if (p < start || p > end) return 0;
      const span = end - start;
      const edge = span * EDGE;
      if (p < start + edge) return (p - start) / edge;
      if (p > end - edge) return (end - p) / edge;
      return 1;
    }

    let latestRanges: SectionRange[] = [];
    let latestMode = 'hire';

    const scrubber = createScrollScrubber({
      canvas,
      track,
      timelines,
      initialMode: 'hire',
      onProgress(progress, mode, ranges: SectionRange[]) {
        latestRanges = ranges;
        latestMode = mode;
        if (scrollCue) scrollCue.style.opacity = progress > 0.02 ? '0' : '1';
        const rangeById: Record<string, SectionRange> = {};
        for (const r of ranges) rangeById[r.id] = r;

        for (const block of blocks) {
          if (block.dataset.copyMode !== mode) {
            block.style.opacity = '0';
            continue;
          }
          const r = rangeById[block.dataset.copyId!];
          const o = r ? opacityForRange(progress, r.start, r.end) : 0;
          block.style.opacity = String(o);
          block.style.transform = `translateY(${(1 - o) * 18}px)`;
        }

        // Sharp 4K still fades in as the scrub settles on its station, hiding the
        // (softer) video frame exactly where the user dwells and reads.
        for (const still of stills) {
          if (still.dataset.stillMode !== mode) {
            still.style.opacity = '0';
            continue;
          }
          const r = rangeById[still.dataset.stillId!];
          still.style.opacity = r ? String(opacityForRange(progress, r.start, r.end)) : '0';
        }
      },
    });

    document.addEventListener('mode-change', (e: Event) => {
      const { mode } = (e as CustomEvent).detail;
      scrubber.setMode(mode);
    });

    // Temporary ?debug=1 on-screen readout — off by default, only active when
    // explicitly requested in the URL, so it never appears for a real visitor.
    if (new URLSearchParams(window.location.search).get('debug') === '1') {
      const readout = document.querySelector<HTMLElement>('[data-debug-readout]');
      if (readout) {
        readout.hidden = false;
        const tick = () => {
          const s = scrubber.getDebugState();
          readout.textContent = [
            `mode=${s.mode}  progress=${s.progress.toFixed(3)}  segment=${s.segmentIndex}`,
            `video.currentTime=${s.videoCurrentTime.toFixed(3)}  seeking=${s.videoSeeking}  readyState=${s.videoReadyState}`,
            `bufferedEnd=${s.videoBufferedEnd.toFixed(3)}`,
          ].join('\n');
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }

    // ---- Magnetic settle-on-release ----------------------------------------
    // Free scrubbing during the gesture — the user's own scroll directly and
    // continuously drives the video. When scrolling stops, ease to the nearest
    // station's centre so it never rests mid-video. Cancels the moment the user
    // scrolls again, and releases past the last station so the page below (the
    // enquiry form) stays reachable.
    let snapToken = 0;
    let isSnapping = false;
    let settleTimer: number | undefined;

    function animateScrollTo(targetY: number) {
      const startY = window.scrollY;
      const dist = targetY - startY;
      if (Math.abs(dist) < 2) return;
      if (reduceMotion) { window.scrollTo(0, targetY); return; }
      // The page uses CSS scroll-behavior:smooth (nice for anchor links) but it
      // would re-animate every programmatic scroll and fight our own easing —
      // force instant during the snap, restore afterwards.
      const root = document.documentElement;
      const prevBehavior = root.style.scrollBehavior;
      root.style.scrollBehavior = 'auto';
      const my = ++snapToken;
      const t0 = performance.now();
      const dur = 520;
      isSnapping = true;
      function finish() {
        isSnapping = false;
        root.style.scrollBehavior = prevBehavior;
      }
      function step(now: number) {
        if (my !== snapToken) { root.style.scrollBehavior = prevBehavior; return; }
        const t = Math.min(1, (now - t0) / dur);
        const eased = 1 - Math.pow(1 - t, 3); // easeOutCubic
        window.scrollTo(0, Math.round(startY + dist * eased));
        if (t < 1) requestAnimationFrame(step);
        else finish();
      }
      requestAnimationFrame(step);
    }

    function trySnap() {
      if (reduceMotion || latestMode == null) return;
      const ranges = latestRanges;
      if (!ranges.length) return;
      const rect = track.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      if (scrollable <= 0) return;
      const progress = Math.max(0, Math.min(1, -rect.top / scrollable));
      const centers = ranges.map((r) => (r.start + r.end) / 2);
      const lastCenter = centers[centers.length - 1];
      // Past the final station: let the user continue to the form below.
      if (progress > lastCenter + 0.01) return;
      let best = centers[0];
      let bestD = Infinity;
      for (const c of centers) {
        const d = Math.abs(c - progress);
        if (d < bestD) { bestD = d; best = c; }
      }
      const trackTopDoc = window.scrollY + rect.top;
      animateScrollTo(trackTopDoc + best * scrollable);
    }

    function onScrollForSnap() {
      if (isSnapping) return; // ignore our own programmatic scroll
      window.clearTimeout(settleTimer);
      settleTimer = window.setTimeout(trySnap, 140);
    }
    function cancelActiveSnap() {
      if (isSnapping) { snapToken++; isSnapping = false; }
    }

    if (!reduceMotion) {
      window.addEventListener('scroll', onScrollForSnap, { passive: true });
      // Any fresh user intent cancels an in-flight snap so it never fights them.
      window.addEventListener('wheel', cancelActiveSnap, { passive: true });
      window.addEventListener('touchmove', cancelActiveSnap, { passive: true });
      window.addEventListener('keydown', cancelActiveSnap);
    }
  }

  initHero();
</script>
