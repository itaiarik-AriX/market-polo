<script>
  import { createScrollScrubber } from '../lib/scrollScrubber';
  import { timelines } from '../lib/heroTimeline';
  import type { SectionRange } from '../lib/heroTimeline';

  function initHero() {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    const track = document.querySelector<HTMLElement>('[data-hero-track]');
    const scrollCue = document.querySelector<HTMLElement>('[data-scroll-cue]');
    const blocks = Array.from(document.querySelectorAll<HTMLElement>('.copy-block'));
    const stills = Array.from(document.querySelectorAll<HTMLElement>('.station-still'));
    let loops = Array.from(document.querySelectorAll<HTMLVideoElement>('.station-loop'));
    const nav = document.querySelector<HTMLElement>('[data-station-nav]');
    const navRails = Array.from(document.querySelectorAll<HTMLElement>('.nav-rail'));
    // Declared up here, not beside the click handler: onProgress fires from
    // inside createScrollScrubber below, so anything it touches has to be
    // initialised before that call rather than after it.
    let latestRanges: Record<string, SectionRange> = {};
    let currentLang = localStorage.getItem('lang') || 'en';
    if (!canvas || !track) return;


    // The loops are decoration. Drop them entirely when the visitor has asked
    // for less motion, or when the browser reports a metered or slow connection
    // — the sharp stills underneath already carry every station on their own.
    const conn = (navigator as any).connection;
    const ambientWanted =
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
      !(conn && (conn.saveData || /(^|\W)(slow-)?2g$/.test(conn.effectiveType ?? '')));

    // Portrait phones get the 9:16 recut of each loop, cut at the same pan
    // centre as the frames and stills so all three are framed identically.
    // Done in script rather than <source media>, which Chrome dropped support
    // for on <video> — only <picture> honours it, which is why the stills can
    // use markup for this and the loops cannot.
    const wantPortraitLoops =
      window.matchMedia('(max-width: 820px) and (orientation: portrait)').matches;
    if (ambientWanted && wantPortraitLoops) {
      for (const v of loops) {
        v.poster = v.poster.replace('/hire-stations/', '/hire-stations-portrait/');
      }
    }

    // Pick ONE format and attach it only when the station is close enough to
    // matter. Listing both a .mp4 and a .webm as <source> children made the
    // browser download both in full, and preload alone still pulled the whole
    // closing clip while the visitor sat at the top — 9.28MB of video before
    // any deliberate scroll, taken from the bandwidth the frames needed.
    const probe = document.createElement('video');
    const loopExt = probe.canPlayType('video/mp4; codecs="avc1.42E01E"') ? 'mp4' : 'webm';

    /** How far ahead of a station's range to start fetching its clip. */
    const LOOP_PREFETCH = 0.08;

    /* Stills are fetched further ahead than clips: a still must be fully there
       to be worth anything (a half-decoded image pops), whereas a clip only has
       to start. */
    const STILL_PREFETCH = 0.16;
    // Same query as PORTRAIT_MQ in the frontmatter and as wantPortraitLoops
    // above; written out because frontmatter constants are build-time only and
    // are not in scope here.
    const wantPortraitStills = wantPortraitLoops;

    function attachStill(img: HTMLImageElement) {
      if (img.src) return; // eager one, or already attached
      const portrait = img.dataset.stillPortrait;
      const base = wantPortraitStills && portrait ? portrait : img.dataset.stillSrc;
      if (base) img.src = base;
    }

    function attachLoopSource(v: HTMLVideoElement) {
      if (v.src) return; // already attached
      const base = v.dataset.loopSrc;
      if (!base) return;
      // Posters are assigned here, never in markup: a poster is fetched
      // eagerly whatever `preload` says, so in markup they pulled stills the
      // visitor was nowhere near (measured: closing's 1.0MB arriving at the top
      // of the page) and always in the landscape tier, so a portrait phone
      // fetched the same station twice. Assigning here picks the right tier and
      // fetches exactly once.
      const poster = wantPortraitLoops && v.dataset.loopPosterPortrait
        ? v.dataset.loopPosterPortrait
        : v.dataset.loopPoster;
      if (poster && !v.poster) v.poster = poster;
      v.src = `${base}${wantPortraitLoops ? '-portrait' : ''}.${loopExt}`;
      v.load();
    }
    if (!ambientWanted) {
      for (const v of loops) v.remove();
      loops = [];
    }

    // Fade a section's copy/still in over the first slice of its hold and out over the last.
    const EDGE = 0.28; // fraction of each hold used for the fade in/out

    const EPS = 1e-6;

    function opacityForRange(p: number, start: number, end: number): number {
      // Tolerant bounds: the ranges are built by accumulating fractions, so the
      // last one ends at 0.9999999999999999 rather than 1. Without the epsilon,
      // progress of exactly 1 falls outside it and the closing station blanks
      // at the very bottom of the track.
      if (p < start - EPS || p > end + EPS) return 0;
      const span = end - start;
      const edge = span * EDGE;
      // A hold pinned to either end of the timeline has nothing to fade from or
      // to: progress 0 is where the page loads and 1 is where it ends. Ramping
      // there would leave the first station's copy — and its ambient loop —
      // invisible on arrival, appearing only once the visitor starts scrolling.
      const atStart = start <= EPS;
      const atEnd = end >= 1 - EPS;
      if (!atStart && p < start + edge) return (p - start) / edge;
      if (!atEnd && p > end - edge) return (end - p) / edge;
      return 1;
    }

    /**
     * Set every copy block's visibility for a given position in the timeline.
     *
     * Shared with the language switch, which is why it is a function. Switching
     * language used to hide the outgoing blocks and stop there, leaving the
     * incoming ones at whatever opacity they last held — zero, since they had
     * never been the visible language. The new copy then only appeared once
     * something else moved the scroll, so on the first station it read as the
     * text vanishing.
     */
    function applyCopy(
      progress: number,
      mode: string,
      rangeById: Record<string, SectionRange>,
    ) {
      for (const block of blocks) {
        if (block.dataset.copyLang !== currentLang || block.dataset.copyMode !== mode) {
          block.style.opacity = '0';
          continue;
        }
        const r = rangeById[block.dataset.copyId!];
        const o = r ? opacityForRange(progress, r.start, r.end) : 0;
        block.style.opacity = String(o);
        block.style.transform = `translateY(${(1 - o) * 18}px)`;
      }
    }

    // ---- intro -----------------------------------------------------------
    // The counter is real: it tracks the landing still decoding and the opening
    // scrub frames arriving. It is NOT a fixed animation — on a fast connection
    // it genuinely finishes early, and on a slow one INTRO_MAX_MS gives up and
    // runs to 100 anyway so nobody is held hostage by 63MB of frames.
    function initIntro(scrub: { getDebugState: () => { loadedCount: number } }) {
      const el = document.querySelector<HTMLElement>('[data-intro]');
      if (!el) return;

      // Once per tab session: a plain reload should not replay it. Closing the
      // tab (or a new one) brings it back, which is the "new visit" case.
      let seen = false;
      try { seen = sessionStorage.getItem('intro-seen') === '1'; } catch {}
      if (seen) { el.hidden = true; return; }
      try { sessionStorage.setItem('intro-seen', '1'); } catch {}

      const countEl = el.querySelector<HTMLElement>('[data-intro-count]');
      const barEl = el.querySelector<HTMLElement>('[data-intro-bar]');
      const elevEl = el.querySelector<HTMLElement>('[data-intro-elev]');
      const contours = Array.from(el.querySelectorAll<SVGPathElement>('.contour'));
      const peakEls = Array.from(el.querySelectorAll<HTMLElement>('.peak'));
      // Each contour draws across a short window that opens at its own
      // elevation, so the terrain rises out of the sea rather than every ring
      // appearing at once. Windows overlap, which is what makes it flow.
      const DRAW_WINDOW = Number(el.dataset.drawWindow || 0.14);
      const maxElev = Number(el.dataset.maxElev || 0);
      const bandCount = Number(el.dataset.bandCount || 1);

      // Peaks are HTML, so their text stays a readable size while the chart
      // scales. That means resolving preserveAspectRatio's letterbox by hand:
      // positioning them as a percentage of the container drifts them off the
      // map, because the SVG is centred inside it rather than filling it.
      const chartEl = el.querySelector<SVGSVGElement>('.intro-chart');
      const vx = Number(el.dataset.viewX || 0);
      const vy = Number(el.dataset.viewY || 0);
      const vw = Number(el.dataset.viewW || 1);
      const vh = Number(el.dataset.viewH || 1);
      const PAD = 10;    // keep a label this far inside the frame
      const GAP = 12;    // from the mark's centre to the start of its text
      const VGAP = 4;    // clear space between two stacked labels
      const MARK = 8;    // half the triangle's box, as an obstacle to other text

      type Box = { l: number; t: number; r: number; b: number };
      const hits = (a: Box, c: Box) => a.l < c.r && c.l < a.r && a.t < c.b && c.t < a.b;

      /**
       * Place every summit's mark on its exact coordinate, then find somewhere
       * for its text that is inside the frame and clear of every other label AND
       * every other mark.
       *
       * Side-flipping alone cannot do this. On a 390px phone Manzaneda and
       * Trevinca project 71px apart at the same latitude, and Trevinca's label
       * needs 375..461 to sit on its right — so no left/right arrangement fits
       * both, and an earlier version simply drew them on top of one another.
       *
       * Nor is text-vs-text enough: with the two labels merely stacked,
       * "Pena Trevinca" ran straight through Manzaneda's triangle, because a
       * mark is an obstacle even when no text is there. So each candidate is
       * tested against the marks too, and the marks never move — they are the
       * entire point of plotting the coordinates.
       */
      function layoutPeaks() {
        if (!chartEl) return;
        const r = chartEl.getBoundingClientRect();
        const k = Math.min(r.width / vw, r.height / vh);
        // r.left/r.top, NOT just the letterbox offset. These positions are
        // written into .intro-peaks, which spans the whole viewport, so they are
        // viewport coordinates — while ox/oy are only offsets within the chart.
        // The two were interchangeable for as long as the chart was inset:0 and
        // started at (0,0); now that it sits inside a column they are not, and
        // dropping these would slide every summit off its coordinate.
        const ox = r.left + (r.width - vw * k) / 2;
        const oy = r.top + (r.height - vh * k) / 2;
        // Labels are clamped to the VIEWPORT rather than to the chart: one
        // beside a summit near the chart's edge may legitimately sit outside
        // the chart box, and there is nothing wrong with it doing so.
        const frameW = window.innerWidth;
        const frameH = window.innerHeight;

        const items = peakEls.map((pk) => {
          const px = ox + (Number(pk.dataset.x || 0) - vx) * k;
          const py = oy + (Number(pk.dataset.y || 0) - vy) * k;
          pk.style.left = `${px}px`;
          pk.style.top = `${py}px`;
          const txt = pk.querySelector<HTMLElement>('.peak-text')!;
          return {
            txt, px, py,
            elev: Number(pk.dataset.peakElev || 0),
            // offsetWidth/Height are the untransformed layout box, so measuring
            // is unaffected by the transform written on the previous pass.
            w: txt.offsetWidth,
            h: txt.offsetHeight,
            mark: { l: px - MARK, t: py - MARK, r: px + MARK, b: py + MARK } as Box,
          };
        });

        // Every mark is an obstacle to every label but its own.
        const marks = items.map((i) => i.mark);
        const taken: Box[] = [];

        // Tallest first, so the headline summit gets the best position and the
        // lesser ones work around it rather than the other way about.
        for (const it of [...items].sort((a, b) => b.elev - a.elev)) {
          const right = it.px + GAP;
          const left = it.px - GAP - it.w;
          const mid = it.px - it.w / 2;
          const above = it.py - it.h - MARK - VGAP;
          const below = it.py + MARK + VGAP;
          const centre = it.py - it.h / 2;
          // Beside the mark reads best, so those come first; above/below are the
          // fallbacks that give a crowded pair somewhere to go.
          const candidates: [number, number][] = [
            [right, centre], [left, centre],
            [right, above], [left, above],
            [right, below], [left, below],
            [mid, above], [mid, below],
          ];

          let best: Box | null = null;
          let bestScore = Infinity;
          for (const [cl, ct] of candidates) {
            const box: Box = { l: cl, t: ct, r: cl + it.w, b: ct + it.h };
            // Outside the frame is disqualifying, not merely expensive.
            if (box.l < PAD || box.t < PAD || box.r > frameW - PAD || box.b > frameH - PAD) continue;
            let score = 0;
            for (const m of marks) if (m !== it.mark && hits(box, m)) score += 10;
            for (const t of taken) if (hits(box, t)) score += 10;
            if (score < bestScore) { bestScore = score; best = box; }
            if (score === 0) break;   // first clean candidate wins
          }

          // Nothing fitted the frame at all: fall back to beside-the-mark,
          // clamped, so a label is never dropped entirely.
          if (!best) {
            const cl = Math.max(PAD, Math.min(right, frameW - PAD - it.w));
            const ct = Math.max(PAD, Math.min(centre, frameH - PAD - it.h));
            best = { l: cl, t: ct, r: cl + it.w, b: ct + it.h };
          }

          taken.push(best);
          it.txt.style.transform = `translate(${best.l - it.px}px, ${best.t - it.py}px)`;
        }
      }
      layoutPeaks();
      window.addEventListener('resize', layoutPeaks);
      // Every position here is derived from a measured text width, so a webfont
      // landing after the first pass would leave the whole layout computed from
      // fallback metrics.
      document.fonts?.ready.then(layoutPeaks);
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Every tunable lives in src/lib/introConfig.ts and arrives on data
      // attributes: frontmatter is build-time only, not in scope here.
      const MIN_MS = Number(el.dataset.minMs || 3600);
      const MAX_MS = Number(el.dataset.maxMs || 6000);
      const HOLD_MS = Number(el.dataset.holdMs || 900);
      const EXIT_MS = Number(el.dataset.exitMs || 1600);
      const DRAW_COMPLETE_AT = Number(el.dataset.drawComplete || 0.86);
      const FRAME_TARGET = 24;   // enough opening frames for a smooth first scrub

      // decode(), not load: it resolves when the image is paintable, which is
      // the difference between a clean reveal and a pop one frame later.
      let stillReady = false;
      const firstStill = document.querySelector<HTMLImageElement>('[data-still-eager]');
      const markStill = () => { stillReady = true; };
      if (!firstStill) {
        stillReady = true;
      } else if (firstStill.complete) {
        firstStill.decode().then(markStill, markStill);
      } else {
        firstStill.addEventListener('load', () => firstStill.decode().then(markStill, markStill), { once: true });
        firstStill.addEventListener('error', markStill, { once: true });
      }

      const started = performance.now();
      let shown = 0;
      let finished = false;

      const real = () => {
        const frames = Math.min(1, scrub.getDebugState().loadedCount / FRAME_TARGET);
        return 0.55 * (stillReady ? 1 : 0) + 0.45 * frames;
      };

      function leave() {
        if (finished) return;
        finished = true;
        el.classList.add('is-leaving');
        window.setTimeout(() => { el.hidden = true; }, reduced ? 0 : EXIT_MS);
      }

      let fullAt = 0;

      function tick() {
        const elapsed = performance.now() - started;
        const done = real() >= 0.999 || elapsed >= MAX_MS;
        // Paced against MIN_MS so the chart actually draws over that time. A
        // warm cache otherwise finishes everything inside a second and then
        // sits at 100 doing nothing, which reads as stuck rather than quick.
        const paced = (elapsed / MIN_MS) * 100;
        // Hold just under 100 until genuinely ready, so the number never claims
        // to be finished while it is still waiting.
        const target = Math.min(paced, done ? 100 : Math.min(96, real() * 100));
        shown += (target - shown) * 0.12;
        if (target >= 100 && 100 - shown < 0.5) shown = 100;
        const v = Math.floor(shown);
        if (countEl) countEl.textContent = String(v);
        if (barEl) barEl.style.width = shown + '%';

        // The survey climbing Galicia: the number is also an altitude.
        const p01 = shown / 100;
        if (elevEl) elevEl.textContent = Math.round(maxElev * p01) + ' m';
        for (const path of contours) {
          // Windows are compressed into [0, 1 - DRAW_WINDOW] so the highest
          // contour still has room to finish by 100%. Mapping band straight to
          // [0,1] left the summit rings opening exactly as the bar completed,
          // so the top three never drew at all.
          // Compressed so the highest contour finishes at DRAW_COMPLETE_AT
          // rather than at 100. Mapping straight onto [0,1] meant the summit
          // rings opened on the very frame the exit fired, so the finished map
          // was never actually on screen.
          const band = (Number(path.dataset.band || 0) / Math.max(1, bandCount - 1))
            * (DRAW_COMPLETE_AT - DRAW_WINDOW);
          const t = Math.max(0, Math.min(1, (p01 - band) / DRAW_WINDOW));
          path.style.strokeDashoffset = String(1 - t);
        }
        for (const pk of peakEls) {
          // Scaled the same way, so the last summit lands with the last
          // contour instead of waiting for the number to reach 100.
          const surveyed = maxElev * Math.min(1, p01 / DRAW_COMPLETE_AT);
          const reached = Number(pk.dataset.peakElev || 0) <= surveyed;
          if (reached && !pk.hasAttribute('data-reached')) pk.setAttribute('data-reached', '');
        }
        // Three conditions, all needed: the count is done, the floor has
        // passed, and the finished chart has been held long enough to be seen.
        if (shown >= 100) {
          if (!fullAt) fullAt = performance.now();
          if (elapsed >= MIN_MS && performance.now() - fullAt >= HOLD_MS) {
            leave();
            return;
          }
        }
        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    const scrubber = createScrollScrubber({
      canvas,
      track,
      timelines,
      initialMode: 'hire',
      onProgress(progress, mode, ranges: SectionRange[]) {
        if (scrollCue) scrollCue.style.opacity = progress > 0.001 ? '0' : '1';
        const rangeById: Record<string, SectionRange> = {};
        for (const r of ranges) rangeById[r.id] = r;
        latestRanges = rangeById;
        updateNav(progress, mode, rangeById);

        applyCopy(progress, mode, rangeById);

        // Sharp full-resolution still fades in as the scrub settles on its
        // station, hiding the (softer) scrub frame exactly where the user
        // dwells and reads.
        for (const still of stills) {
          if (still.dataset.stillMode !== mode) {
            still.style.opacity = '0';
            continue;
          }
          const r = rangeById[still.dataset.stillId!];
          const o = r ? opacityForRange(progress, r.start, r.end) : 0;
          // Fetch before it is needed, never on arrival — an image assigned at
          // the moment it should be visible fades in blank and pops.
          if (r && (o > 0 || (progress > r.start - STILL_PREFETCH && progress < r.end + STILL_PREFETCH))) {
            attachStill(still as HTMLImageElement);
          }
          still.style.opacity = String(o);
        }

        // Ambient loop rides the same curve as its still, so the handover is a
        // pure function of scroll position — scroll back up mid-fade and it
        // fades back in. Nothing animates on its own, nothing to wait out.
        for (const v of loops) {
          if (v.dataset.loopMode !== mode) {
            v.style.opacity = '0';
            stopLoop(v);
            continue;
          }
          const r = rangeById[v.dataset.loopId!];
          const o = r ? opacityForRange(progress, r.start, r.end) : 0;
          // Fetch a little ahead of the station so the clip is ready by the
          // time it fades in, but never before. The first station's range
          // starts at 0, so the landing loop still attaches immediately — it is
          // the one clip genuinely needed up front.
          if (r && (o > 0 || (progress > r.start - LOOP_PREFETCH && progress < r.end + LOOP_PREFETCH))) {
            attachLoopSource(v);
          }
          v.style.opacity = String(o);
          // Decode only while it is actually visible: by the time the canvas
          // starts scrubbing, every loop is paused.
          if (o > 0) startLoop(v);
          else stopLoop(v);
        }
      },
    });

    // Started only once the scrubber exists, since the counter reads its real
    // loaded-frame count.
    initIntro(scrubber);

    if (nav) {
      // Jumping the page is allowed HERE and nowhere else. What was removed from
      // this component was the page moving on the user's behalf after a gesture;
      // a jump in direct response to a click is the user asking to be moved.
      nav.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-nav-jump]');
        if (!btn) return;
        const r = latestRanges[btn.dataset.navJump!];
        if (!r) return;
        const scrollable = track!.getBoundingClientRect().height - window.innerHeight;
        if (scrollable <= 0) return;
        const centre = (r.start + r.end) / 2;
        const top = Math.round(track!.offsetTop + centre * scrollable);
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top, behavior: reduced ? 'auto' : 'smooth' });
      });
    }

    function updateNav(progress: number, mode: string, rangeById: Record<string, SectionRange>) {
      if (!nav) return;
      // The fill is raw scroll progress, and each stop is pinned to its own true
      // position, so the head reaches a mark exactly as the scrub settles there.
      nav.style.setProperty('--nav-progress', `${(progress * 100).toFixed(2)}%`);
      for (const rail of navRails) {
        const isMode = rail.dataset.navMode === mode;
        rail.hidden = !isMode;
        if (!isMode) continue;
        for (const stop of Array.from(rail.querySelectorAll<HTMLElement>('.nav-stop'))) {
          const r = rangeById[stop.dataset.navJump!];
          // Active only while the scrub is genuinely resting on that station.
          // Mid-motion nothing lights up: snapping the marker to the nearest
          // station would claim the user is somewhere they are not.
          const active = !!r && progress >= r.start - EPS && progress <= r.end + EPS;
          stop.classList.toggle('is-active', active);
          stop.setAttribute('aria-current', active ? 'true' : 'false');
        }
      }
    }

    // play()/pause() are async and interrupt each other if called while one is
    // still settling, so gate on our own intent rather than on v.paused.
    function startLoop(v: HTMLVideoElement) {
      if (v.dataset.playing === '1') return;
      v.dataset.playing = '1';
      // A rejection here just means autoplay was refused; the poster and the
      // still underneath already show the right frame, so there is nothing to do.
      v.play().catch(() => {});
    }
    function stopLoop(v: HTMLVideoElement) {
      if (v.dataset.playing !== '1') return;
      v.dataset.playing = '';
      v.pause();
    }

    document.addEventListener('mode-change', (e: Event) => {
      const { mode } = (e as CustomEvent).detail;
      scrubber.setMode(mode);
    });

    // The rail is rendered at build time with both languages in data
    // attributes, so switching is a text swap rather than a re-render.
    const GO_TO: Record<string, string> = { en: 'Go to', es: 'Ir a' };
    function applyNavLang(lang: string) {
      for (const rail of navRails) {
        for (const stop of Array.from(rail.querySelectorAll<HTMLElement>('.nav-stop'))) {
          const label = stop.dataset[lang === 'es' ? 'labelEs' : 'labelEn'];
          if (!label) continue;
          const span = stop.querySelector('.nav-label');
          if (span) span.textContent = label;
          stop.setAttribute('aria-label', `${GO_TO[lang] ?? GO_TO.en} ${label}`);
        }
      }
      const nav = document.querySelector('[data-station-nav]');
      if (nav) {
        nav.setAttribute('aria-label', lang === 'es' ? 'Ir a una seccion' : 'Jump to a section');
      }
    }

    document.addEventListener('language-change', (e: Event) => {
      const { lang } = (e as CustomEvent).detail;
      currentLang = lang;
      // Re-run the SAME visibility pass the scroll handler uses, at wherever
      // the visitor currently is. Only hiding the outgoing blocks left the
      // incoming ones at opacity 0 until the next scroll — which on the first
      // station looked like the text simply disappearing.
      applyCopy(scrubber.getProgress(), scrubber.getMode(), latestRanges);
      applyNavLang(currentLang);
    });

    applyNavLang(currentLang);

    // NOTE: there is deliberately NO scroll manipulation here — no magnetic
    // snap, no scrollIntoView, no wheel/touch preventDefault, no stepping.
    // The page scrolls natively and the user is always in full control; the
    // canvas simply reflects wherever they are. Anything that moves the page
    // on the user's behalf is what made earlier versions feel like they were
    // fighting back, so it stays out.

    // Temporary ?debug=1 on-screen readout — off by default, only active when
    // explicitly requested in the URL, so it never appears for a real visitor.
    if (new URLSearchParams(window.location.search).get('debug') === '1') {
      const readout = document.querySelector<HTMLElement>('[data-debug-readout]');
      if (readout) {
        readout.hidden = false;
        const tick = () => {
          const s = scrubber.getDebugState();
          readout.textContent = [
            `mode=${s.mode}  progress=${s.progress.toFixed(3)}`,
            `frame wanted=${s.desiredFrame}  drawn=${s.drawnFrame}`,
            `loaded=${s.loadedCount}/${s.frameCount}`,
          ].join('\n');
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }
  }

  initHero();
</script>
