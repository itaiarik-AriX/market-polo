  }
  .station-still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    will-change: opacity;
  }
  /* Ambient station loops, layered directly over the stills with identical
     cover geometry so the two are pixel-aligned and can crossfade cleanly. */
  .hero-loops {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .station-loop {
    position: absolute;
    inset: 0;
    width: 100%;
