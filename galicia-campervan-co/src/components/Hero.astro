---
// Copy is keyed by section id (see src/lib/heroTimeline.ts). Each block fades in
// while the video holds on that section's frame. Wording is a first draft — easy
// to refine. The van's real details go in the Hire "van-bed" / "kitchen" blocks.
const copy = {
  hire: {
    welcome: {
      eyebrow: 'Galicia Campervan Co',
      title: 'Wake up somewhere the map forgot.',
      body: 'A classic camper, the open coast, and nowhere you have to be.',
    },
    'van-bed': {
      eyebrow: 'The van & the bed',
      title: 'A classic VW, a proper bed.',
      body: 'Restored, road-ready, and made for real rest at the end of the day.',
    },
    kitchen: {
      eyebrow: 'The kitchen',
      title: 'Everything you need to cook on the road.',
      body: 'A full little galley — so dinner with a view is always on the menu.',
    },
    dream: {
      eyebrow: 'The dream',
      title: 'Chase the sunset. Park at the edge of it.',
      body: 'Slow mornings, salt air, and a home that moves with you.',
    },
    closing: {
      eyebrow: 'Ready?',
      title: 'Ready to hit the road?',
      body: 'Tell us your dates below — we’ll write back personally.',
    },
  },
  build: {
    welcome: {
      eyebrow: 'Galicia Campervan Co',
      title: 'Every camper starts as steel and imagination.',
      body: 'This is where your build begins.',
    },
    engineering: {
      eyebrow: 'Engineering',
      title: 'Engineered underneath.',
      body: 'Insulation, electrics and systems done properly — so nothing lets you down.',
    },
    joinery: {
      eyebrow: 'Craftsmanship',
      title: 'Bespoke joinery, built by hand.',
      body: 'Every cabinet fitted to your van, not a generic kit.',
    },
    finish: {
      eyebrow: 'The finish',
      title: 'Finished to live in, not just to look at.',
      body: 'A complete build, ready for the road.',
    },
    closing: {
      eyebrow: 'Ready?',
      title: 'Ready to build yours?',
      body: 'Tell us what you have in mind below.',
    },
  },
};
---
<section class="hero-track" id="top" data-hero-track>
  <div class="hero-stage">
    <canvas data-hero-canvas aria-hidden="true"></canvas>
    <div class="hero-vignette" aria-hidden="true"></div>

    <div class="hero-copy">
      {Object.entries(copy).map(([mode, sections]) => (
        Object.entries(sections).map(([id, block]) => (
          <div class="copy-block" data-copy-mode={mode} data-copy-id={id}>
            <p class="eyebrow">{block.eyebrow}</p>
            <h2 class="serif copy-title">{block.title}</h2>
            <p class="copy-body">{block.body}</p>
          </div>
        ))
      ))}
    </div>

    <div class="scroll-cue" data-scroll-cue aria-hidden="true">
      <span></span>
      Scroll
    </div>
  </div>
</section>

<style>
  .hero-track {
    position: relative;
    height: 900vh; /* total scroll distance; more = slower, more cinematic scrub */
  }
  .hero-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    background: var(--bg);
  }
  .hero-stage canvas {
    position: absolute;
    inset: 0;
    display: block;
  }
  .hero-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.42) 0%, rgba(0, 0, 0, 0) 26%, rgba(0, 0, 0, 0) 58%, rgba(0, 0, 0, 0.62) 100%);
    pointer-events: none;
  }

  .hero-copy {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .copy-block {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12vh;
    padding: 0 2rem;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    opacity: 0;
    transform: translateY(18px);
    will-change: opacity, transform;
  }
  .copy-block .eyebrow {
    margin-bottom: 0.9rem;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.7);
  }
  .copy-title {
    font-weight: 400;
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--fg);
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.6);
  }
  .copy-body {
    margin-top: 1rem;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    color: var(--fg);
    opacity: 0.92;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.7);
  }

  .scroll-cue {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-dim);
    transition: opacity 0.4s ease;
  }
  .scroll-cue span {
    width: 1px;
    height: 32px;
    background: linear-gradient(180deg, var(--fg-dim), transparent);
    animation: scroll-cue-move 1.8s ease-in-out infinite;
  }
  @keyframes scroll-cue-move {
    0% { transform: scaleY(0.3); opacity: 0.3; }
    50% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(0.3); opacity: 0.3; }
  }

  @media (max-width: 640px) {
    .copy-block { bottom: 14vh; }
  }
</style>

<script>
  import { createScrollScrubber } from '../lib/scrollScrubber';
  import { timelines } from '../lib/heroTimeline';
  import type { SectionRange } from '../lib/heroTimeline';

  function initHero() {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    const track = document.querySelector<HTMLElement>('[data-hero-track]');
    const scrollCue = document.querySelector<HTMLElement>('[data-scroll-cue]');
    const blocks = Array.from(document.querySelectorAll<HTMLElement>('.copy-block'));
    if (!canvas || !track) return;

    // Fade a section's copy in over the first slice of its hold and out over the last.
    const EDGE = 0.28; // fraction of each hold used for the fade in/out

    function opacityForRange(p: number, start: number, end: number): number {
      if (p < start || p > end) return 0;
      const span = end - start;
      const edge = span * EDGE;
      if (p < start + edge) return (p - start) / edge;
      if (p > end - edge) return (end - p) / edge;
      return 1;
    }

    const scrubber = createScrollScrubber({
      canvas,
      track,
      timelines,
      initialMode: 'hire',
      onProgress(progress, mode, ranges: SectionRange[]) {
        if (scrollCue) scrollCue.style.opacity = progress > 0.02 ? '0' : '1';
        const rangeById: Record<string, SectionRange> = {};
        for (const r of ranges) rangeById[r.id] = r;

        for (const block of blocks) {
          if (block.dataset.copyMode !== mode) {
            block.style.opacity = '0';
            continue;
          }
          const r = rangeById[block.dataset.copyId!];
          const o = r ? opacityForRange(progress, r.start, r.end) : 0;
          block.style.opacity = String(o);
          block.style.transform = `translateY(${(1 - o) * 18}px)`;
        }
      },
    });

    document.addEventListener('mode-change', (e: Event) => {
      const { mode } = (e as CustomEvent).detail;
      scrubber.setMode(mode);
    });
  }

  initHero();
</script>
