---
import { timelines } from '../lib/heroTimeline';

// Build the list of high-res station stills (only for modes that provide them).
const stationStills = Object.entries(timelines).flatMap(([mode, tl]) =>
  tl.stationsBase
    ? tl.sections.map((s) => ({
        mode,
        id: s.id,
        src: `${tl.stationsBase}${s.id}.${tl.stationsExt ?? 'webp'}`,
      }))
    : []
);

// Copy is keyed by station id (see src/lib/heroTimeline.ts). Wording is a
// first draft — easy to refine once real van specifics are settled.
const copy = {
  hire: {
    welcome: {
      eyebrow: 'Galicia Campervan Co',
      title: 'Wake up somewhere the map forgot.',
      body: 'A classic camper, the open coast, and nowhere you have to be.',
    },
    exterior: {
      eyebrow: 'The van',
      title: 'A classic, through and through.',
      body: 'Restored, road-ready, and unmistakably retro — inside and out.',
    },
    amenities: {
      eyebrow: 'What’s inside',
      title: 'Everything you need for the road.',
      body: 'A proper bed, a hot side shower, and a full kitchen — all in reach.',
    },
    view: {
      eyebrow: 'Pull over anywhere',
      title: 'Wherever you stop, that’s the view.',
      body: 'No campsite required — just a spot you like the look of.',
    },
    closing: {
      eyebrow: 'Ready?',
      title: 'Ready to hit the road?',
      body: 'Tell us your dates below — we’ll write back personally.',
    },
  },
  build: {
    welcome: {
      eyebrow: 'Galicia Campervan Co',
      title: 'Every camper starts as steel and imagination.',
      body: 'This is where your build begins.',
    },
    engineering: {
      eyebrow: 'Engineering',
      title: 'Engineered underneath.',
      body: 'Insulation, electrics and systems done properly — so nothing lets you down.',
    },
    joinery: {
      eyebrow: 'Craftsmanship',
      title: 'Bespoke joinery, built by hand.',
      body: 'Every cabinet fitted to your van, not a generic kit.',
    },
    finish: {
      eyebrow: 'The finish',
      title: 'Finished to live in, not just to look at.',
      body: 'A complete build, ready for the road.',
    },
    closing: {
      eyebrow: 'Ready?',
      title: 'Ready to build yours?',
      body: 'Tell us what you have in mind below.',
    },
  },
};
---
<section class="hero-stage" id="top" data-hero-stage>
  <canvas data-hero-canvas aria-hidden="true"></canvas>

  <div class="hero-stills" aria-hidden="true">
    {stationStills.map((st) => (
      <img
        class="station-still"
        data-still-mode={st.mode}
        data-still-id={st.id}
        src={st.src}
        alt=""
        loading="eager"
        decoding="async"
      />
    ))}
  </div>

  <div class="hero-vignette" aria-hidden="true"></div>

  <div class="hero-copy">
    {Object.entries(copy).map(([mode, sections]) => (
      Object.entries(sections).map(([id, block]) => (
        <div class="copy-block" data-copy-mode={mode} data-copy-id={id}>
          <p class="eyebrow">{block.eyebrow}</p>
          <h2 class="serif copy-title">{block.title}</h2>
          <p class="copy-body">{block.body}</p>
        </div>
      ))
    ))}
  </div>

  <div class="scroll-cue" data-scroll-cue aria-hidden="true">
    <span></span>
    Scroll
  </div>

  <div class="loading-cue" data-loading-cue aria-hidden="true">
    <span class="loading-dot"></span>
    Loading
  </div>

  <pre class="debug-readout" data-debug-readout aria-hidden="true" hidden></pre>
</section>

<style>
  .hero-stage {
    position: relative;
    height: 100vh;
    overflow: hidden;
    background: var(--bg);
  }
  .hero-stage canvas {
    position: absolute;
    inset: 0;
    display: block;
  }
  .hero-stills {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .station-still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    /* Snappy fade so the sharp still asserts itself the instant we land,
       rather than a slow soft-to-sharp morph over the video frame. */
    transition: opacity 0.22s ease-out;
    will-change: opacity;
  }
  .station-still.is-visible {
    opacity: 1;
  }
  .hero-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.42) 0%, rgba(0, 0, 0, 0) 26%, rgba(0, 0, 0, 0) 58%, rgba(0, 0, 0, 0.62) 100%);
    pointer-events: none;
  }

  .hero-copy {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .copy-block {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12vh;
    padding: 0 2rem;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.32s ease, transform 0.32s ease;
    will-change: opacity, transform;
  }
  .copy-block.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .copy-block .eyebrow {
    margin-bottom: 0.9rem;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.7);
  }
  .copy-title {
    font-weight: 400;
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--fg);
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.6);
  }
  .copy-body {
    margin-top: 1rem;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    color: var(--fg);
    opacity: 0.92;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.7);
  }

  .scroll-cue {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-dim);
    transition: opacity 0.4s ease;
  }
  .scroll-cue span {
    width: 1px;
    height: 32px;
    background: linear-gradient(180deg, var(--fg-dim), transparent);
    animation: scroll-cue-move 1.8s ease-in-out infinite;
  }
  @keyframes scroll-cue-move {
    0% { transform: scaleY(0.3); opacity: 0.3; }
    50% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(0.3); opacity: 0.3; }
  }

  /* Shown only while waiting for a station's video data to actually finish
     downloading — an honest wait instead of a frozen-looking video. */
  .loading-cue {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-dim);
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }
  .loading-cue.is-visible {
    opacity: 1;
  }
  .loading-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--fg-dim);
    animation: loading-dot-pulse 1s ease-in-out infinite;
  }
  @keyframes loading-dot-pulse {
    0%, 100% { opacity: 0.3; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.15); }
  }

  @media (max-width: 640px) {
    .copy-block { bottom: 14vh; }
  }

  /* Temporary diagnostic readout, opt-in only via ?debug=1 — never shown to a
     real visitor. Lets a bug report be a screenshot of real internal state
     instead of a description. Remove once no longer needed. */
  .debug-readout {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 20;
    margin: 0;
    padding: 0.6rem 0.8rem;
    background: rgba(0, 0, 0, 0.75);
    color: #7CFC9A;
    font-size: 0.72rem;
    line-height: 1.5;
    border-radius: 6px;
    pointer-events: none;
    white-space: pre;
  }
</style>

<script>
  import { createHeroStepper } from '../lib/heroStepper';
  import { timelines } from '../lib/heroTimeline';

  function initHero() {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    const heroStage = document.querySelector<HTMLElement>('[data-hero-stage]');
    const enquireEl = document.querySelector<HTMLElement>('#enquire');
    const scrollCue = document.querySelector<HTMLElement>('[data-scroll-cue]');
    const loadingCue = document.querySelector<HTMLElement>('[data-loading-cue]');
    const blocks = Array.from(document.querySelectorAll<HTMLElement>('.copy-block'));
    const stills = Array.from(document.querySelectorAll<HTMLElement>('.station-still'));
    if (!canvas || !heroStage) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const stepper = createHeroStepper({
      canvas,
      timelines,
      initialMode: 'hire',
      reduceMotion,
      // The moment a move begins, hide the sharp still + copy so the playing
      // video underneath is visible; onStation fades the new ones back in on
      // arrival. Without this the still sits opaquely on top of the canvas and
      // the motion is never seen.
      onTransitionStart() {
        if (scrollCue) scrollCue.style.opacity = '0';
        for (const block of blocks) block.classList.remove('is-visible');
        for (const still of stills) still.classList.remove('is-visible');
      },
      // Fires while a move is waiting for that station's video data to finish
      // downloading (see heroStepper's isBuffered/waitForBuffer). The current
      // still + copy are left alone during the wait — only this cue appears.
      onBufferWait(_mode, waiting) {
        if (loadingCue) loadingCue.classList.toggle('is-visible', waiting);
      },
      onStation(mode, stationId) {
        if (scrollCue) scrollCue.style.opacity = stationId === 'welcome' ? '1' : '0';
        for (const block of blocks) {
          const show = block.dataset.copyMode === mode && block.dataset.copyId === stationId;
          block.classList.toggle('is-visible', show);
        }
        for (const still of stills) {
          const show = still.dataset.stillMode === mode && still.dataset.stillId === stationId;
          still.classList.toggle('is-visible', show);
        }
      },
    });

    document.addEventListener('mode-change', (e: Event) => {
      const { mode } = (e as CustomEvent).detail;
      stepper.setMode(mode);
    });

    // Temporary ?debug=1 on-screen readout (see plan notes) — off by default,
    // only active when explicitly requested in the URL, so it never appears
    // for a real visitor.
    if (new URLSearchParams(window.location.search).get('debug') === '1') {
      const readout = document.querySelector<HTMLElement>('[data-debug-readout]');
      if (readout) {
        readout.hidden = false;
        const tick = () => {
          const s = stepper.getDebugState();
          readout.textContent = [
            `mode=${s.mode}  station=${s.stationIndex} (${s.stationId})  busy=${s.busy}`,
            `video.currentTime=${s.videoCurrentTime.toFixed(3)}  seeking=${s.videoSeeking}  readyState=${s.videoReadyState}`,
            `activeFrom=${s.activeFrom === null ? '-' : s.activeFrom.toFixed(3)}  activeTo=${s.activeTo === null ? '-' : s.activeTo.toFixed(3)}`,
            `bufferedEnd=${s.videoBufferedEnd.toFixed(3)}`,
          ].join('\n');
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }

    // ---- Discrete station navigation ---------------------------------------
    // The hero "has focus" while the page is scrolled to the very top (it's
    // the first section, filling the viewport). While focused, wheel/touch/key
    // input steps one station at a time instead of scrolling the page — so the
    // view can only ever rest on a station, never mid-video. Scrolling forward
    // past the last station releases control to the page below; scrolling up
    // from there returns focus and resumes exactly where the user left off.
    function isFocused() {
      return window.scrollY <= 1;
    }

    function releaseForward() {
      if (!enquireEl) return;
      enquireEl.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
    }

    function handleDirection(dir: 1 | -1) {
      if (!isFocused() || stepper.isBusy()) return;
      const moved = stepper.step(dir);
      if (!moved && dir === 1) releaseForward();
      // dir === -1 with no movement (already at first station): nothing to do.
    }

    // Trackpad momentum tails off with progressively smaller deltaY ticks —
    // ignoring weak ones stops a decaying flick from re-triggering a step
    // after the cooldown window ends.
    const MIN_WHEEL_DELTA = 4;

    window.addEventListener('wheel', (e: WheelEvent) => {
      if (!isFocused()) return;
      e.preventDefault();
      if (stepper.isBusy()) return;
      if (Math.abs(e.deltaY) < MIN_WHEEL_DELTA) return;
      handleDirection(e.deltaY > 0 ? 1 : -1);
    }, { passive: false });

    let touchStartY = 0;
    window.addEventListener('touchstart', (e: TouchEvent) => {
      if (!isFocused()) return;
      touchStartY = e.touches[0].clientY;
    }, { passive: true });
    window.addEventListener('touchmove', (e: TouchEvent) => {
      if (!isFocused()) return;
      e.preventDefault(); // stop rubber-banding while we own the gesture
    }, { passive: false });
    window.addEventListener('touchend', (e: TouchEvent) => {
      if (!isFocused()) return;
      const dy = touchStartY - e.changedTouches[0].clientY;
      if (Math.abs(dy) < 40) return; // ignore taps / tiny movements
      handleDirection(dy > 0 ? 1 : -1);
    });

    window.addEventListener('keydown', (e: KeyboardEvent) => {
      if (!isFocused()) return;
      if (['ArrowDown', 'PageDown', ' '].includes(e.key)) {
        e.preventDefault();
        handleDirection(1);
      } else if (['ArrowUp', 'PageUp'].includes(e.key)) {
        e.preventDefault();
        handleDirection(-1);
      }
    });
  }

  initHero();
</script>
