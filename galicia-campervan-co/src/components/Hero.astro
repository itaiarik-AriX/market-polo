---
// Placeholder copy below — swap for real copy/specs once you've settled on
// brand voice and actual van details. Ranges are fractions (0-1) of the
// total scroll-through distance for that mode's sequence.
const copy = {
  hire: [
    { range: [0, 0.2], eyebrow: 'The vision', title: 'The dream starts at the edge of the world.', body: 'One campervan. An empty coastline. Nowhere you need to be.' },
    { range: [0.2, 0.42], eyebrow: 'The van', title: 'A classic, fully restored.', body: 'Mechanically sound, road-ready, and built to go the distance.' },
    { range: [0.42, 0.68], eyebrow: 'The kitchen', title: 'A kitchen built for real cooking.', body: 'Everything you need for the road, nothing you don’t.' },
    { range: [0.68, 0.9], eyebrow: 'The bed', title: 'Somewhere to land, wherever the day ends.', body: 'Comfortable, proper rest — not a compromise.' },
    { range: [0.9, 1], eyebrow: 'Ready?', title: 'Ready when you are.', body: 'Tell us your dates below.' },
  ],
  build: [
    { range: [0, 0.2], eyebrow: 'The vision', title: 'Every campervan starts as steel and imagination.', body: 'This is where your build begins.' },
    { range: [0.2, 0.42], eyebrow: 'Engineering', title: 'Engineered underneath.', body: 'Insulation, electrics, and systems done properly — so nothing lets you down.' },
    { range: [0.42, 0.68], eyebrow: 'Craftsmanship', title: 'Bespoke joinery, built by hand.', body: 'Every cabinet fitted to your van, not a generic kit.' },
    { range: [0.68, 0.9], eyebrow: 'The finish', title: 'Finished to live in, not just to look at.', body: 'A complete build, ready for the road.' },
    { range: [0.9, 1], eyebrow: 'Ready?', title: 'Ready to build yours?', body: 'Tell us what you have in mind below.' },
  ],
};
---
<section class="hero-track" id="top" data-hero-track>
  <div class="hero-stage">
    <canvas data-hero-canvas aria-hidden="true"></canvas>
    <div class="hero-vignette" aria-hidden="true"></div>

    <div class="hero-copy">
      {Object.entries(copy).map(([mode, blocks]) => (
        blocks.map((block, i) => (
          <div
            class="copy-block"
            data-copy-mode={mode}
            data-range={block.range.join(',')}
            data-index={i}
          >
            <p class="eyebrow">{block.eyebrow}</p>
            <h2 class="serif copy-title">{block.title}</h2>
            <p class="copy-body">{block.body}</p>
          </div>
        ))
      ))}
    </div>

    <div class="scroll-cue" data-scroll-cue aria-hidden="true">
      <span></span>
      Scroll
    </div>
  </div>
</section>

<style>
  .hero-track {
    position: relative;
    height: 500vh; /* total scroll distance mapped to the sequence's frame range */
  }
  .hero-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    background: var(--bg);
  }
  .hero-stage canvas {
    position: absolute;
    inset: 0;
    display: block;
  }
  .hero-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0) 30%, rgba(0, 0, 0, 0) 60%, rgba(0, 0, 0, 0.55) 100%);
    pointer-events: none;
  }

  .hero-copy {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    pointer-events: none;
  }
  .copy-block {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12vh;
    padding: 0 2rem;
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.25s linear, transform 0.25s ease;
  }
  .copy-block .eyebrow {
    margin-bottom: 0.85rem;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.6);
  }
  .copy-title {
    font-weight: 400;
    font-size: clamp(1.9rem, 4.6vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--fg);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.55);
  }
  .copy-body {
    margin-top: 1rem;
    font-size: 1.05rem;
    color: var(--fg-dim);
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.6);
  }

  .scroll-cue {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-dim);
    transition: opacity 0.4s ease;
  }
  .scroll-cue span {
    width: 1px;
    height: 32px;
    background: linear-gradient(180deg, var(--fg-dim), transparent);
    animation: scroll-cue-move 1.8s ease-in-out infinite;
  }
  @keyframes scroll-cue-move {
    0% { transform: scaleY(0.3); opacity: 0.3; }
    50% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(0.3); opacity: 0.3; }
  }

  @media (max-width: 640px) {
    .hero-track {
      height: 420vh;
    }
    .copy-block {
      bottom: 14vh;
    }
  }
</style>

<script>
  import { createScrollScrubber } from '../lib/scrollScrubber';

  function initHero() {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    const track = document.querySelector<HTMLElement>('[data-hero-track]');
    const scrollCue = document.querySelector<HTMLElement>('[data-scroll-cue]');
    const copyBlocks = Array.from(document.querySelectorAll<HTMLElement>('.copy-block'));
    if (!canvas || !track) return;

    const FADE_MARGIN = 0.03;

    function opacityFor(progress: number, start: number, end: number) {
      if (progress < start - FADE_MARGIN || progress > end + FADE_MARGIN) return 0;
      if (progress < start) return (progress - (start - FADE_MARGIN)) / FADE_MARGIN;
      if (progress > end) return 1 - (progress - end) / FADE_MARGIN;
      return 1;
    }

    const scrubber = createScrollScrubber({
      canvas,
      track,
      initialMode: 'hire',
      sequences: {
        hire: { basePath: '/sequences/hire/', frameCount: 60, pad: 4, ext: 'svg' },
        build: { basePath: '/sequences/build/', frameCount: 60, pad: 4, ext: 'svg' },
      },
      onProgress(progress, mode) {
        if (scrollCue) scrollCue.style.opacity = progress > 0.03 ? '0' : '1';
        for (const block of copyBlocks) {
          const blockMode = block.dataset.copyMode;
          if (blockMode !== mode) {
            block.style.opacity = '0';
            block.style.pointerEvents = 'none';
            continue;
          }
          const [start, end] = block.dataset.range!.split(',').map(Number);
          const o = opacityFor(progress, start, end);
          block.style.opacity = String(o);
          block.style.transform = `translateY(${(1 - o) * 16}px)`;
          block.style.pointerEvents = o > 0.5 ? 'auto' : 'none';
        }
      },
    });

    document.addEventListener('mode-change', (e: Event) => {
      const { mode } = (e as CustomEvent).detail;
      scrubber.setMode(mode);
    });
  }

  initHero();
</script>
