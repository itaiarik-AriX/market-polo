---
import { timelines, buildTimeline } from '../lib/heroTimeline';
import {
  CHART_BANDS, CHART_PEAKS, CHART_VIEWBOX, VIEW_X, VIEW_Y, VIEW_W, VIEW_H,
  MAX_ELEV, BAND_COUNT,
} from '../lib/galiciaChart';

// Build the list of high-res station stills (only for modes that provide them).
// Each still is the SAME frame the canvas holds on, at full resolution — so it
// "sharpens in" seamlessly when the scrub settles on that station.
// `portraitSrc` is the same station recut 9:16, matching basePathPortrait. The
// browser picks between them from the media query on the <source>, so the still
// can never disagree with the frames the scrubber loaded.
// `eager` is the first station of each mode — the only still on screen when the
// page opens. The rest are attached as their station approaches (see
// attachStill), because loading all five up front cost 3.0MB of which 2.4MB was
// invisible, and that traffic competed with both the still the visitor IS
// looking at and the scrub frames behind it.
const stationStills = Object.entries(timelines).flatMap(([mode, tl]) =>
  tl.stationsBase
    ? tl.sections.map((s, i) => ({
        mode,
        id: s.id,
        eager: i === 0,
        src: `${tl.stationsBase}${s.id}.${tl.stationsExt ?? tl.ext}`,
        portraitSrc: tl.stationsBasePortrait
          ? `${tl.stationsBasePortrait}${s.id}.${tl.stationsExt ?? tl.ext}`
          : undefined,
      }))
    : []
);

// Kept in step with `usePortraitTier` in scrollScrubber.ts — the two must agree
// or a portrait still would fade in over landscape frames.
const PORTRAIT_MQ = '(max-width: 820px) and (orientation: portrait)';

// Ambient loops, for the stations that declare one (see Section.loop). The clip
// opens on the same frame the canvas holds on, so it can crossfade against an
// identical image rather than against motion.
const stationLoops = Object.entries(timelines).flatMap(([mode, tl]) =>
  tl.sections
    .filter((s) => s.loop)
    .map((s) => ({
      mode,
      id: s.id,
      src: s.loop!,
      // Poster is that station's own still, so there is never a blank frame
      // while the clip arrives — and it is already being fetched for the
      // .station-still layer, so it costs nothing extra.
      poster: tl.stationsBase
        ? `${tl.stationsBase}${s.id}.${tl.stationsExt ?? tl.ext}`
        : undefined,
      posterPortrait: tl.stationsBasePortrait
        ? `${tl.stationsBasePortrait}${s.id}.${tl.stationsExt ?? tl.ext}`
        : undefined,
      // Only the station the page lands on is worth fetching up front.
      eager: tl.sections[0].id === s.id,
    }))
);

// Short labels for the station navigator — the copy headlines are far too long
// to sit in a rail. Keyed the same way as `copy` below.
const navLabels: Record<string, Record<string, Record<string, string>>> = {
  en: {
    hire: {
      welcome: 'Welcome',
      exterior: 'The van',
      amenities: 'Living in it',
      view: 'The view',
      closing: 'The keys',
    },
    build: {
      welcome: 'Welcome',
      engineering: 'The build',
      joinery: 'Inside',
      finish: 'The life',
      closing: 'The start',
    },
  },
  es: {
    hire: {
      welcome: 'Bienvenida',
      exterior: 'La furgo',
      amenities: 'Vivirla',
      view: 'Las vistas',
      closing: 'Las llaves',
    },
    build: {
      welcome: 'Bienvenida',
      engineering: 'El trabajo',
      joinery: 'Dentro',
      finish: 'La vida',
      closing: 'El principio',
    },
  },
};

// Each stop is placed at its TRUE scroll position, not spread evenly down the
// rail. The stations are not equally spaced in scroll — holds and motions carry
// different weights — so evenly-spaced marks would sit up to 16px away from
// where the fill head actually arrives, which on a progress bar reads as broken.
// buildTimeline is the same function the scrubber uses, so the two cannot drift.
const navStations = Object.entries(timelines).map(([mode, tl]) => {
  const ranges = Object.fromEntries(
    buildTimeline(tl).sectionRanges.map((r) => [r.id, r])
  );
  return {
    mode,
    items: tl.sections.map((s) => {
      const r = ranges[s.id];
      return {
        id: s.id,
        // Both languages are emitted up front and swapped client-side, the same
        // way the copy blocks are — the rail is built at build time, so it
        // cannot read localStorage.
        labels: Object.fromEntries(
          Object.entries(navLabels).map(([lang, byMode]) => [lang, byMode[mode]?.[s.id] ?? s.id])
        ),
        at: (((r.start + r.end) / 2) * 100).toFixed(2),
      };
    }),
  };
});

// Copy is keyed by language, then mode, then section id (see src/lib/heroTimeline.ts).
// Each block fades in while the sequence holds on that section's frame.
const copy = {
  en: {
    hire: {
      welcome: {
        title: 'Take the van. Follow the coast.',
        body: [
          'A restored camper, the Atlantic outside, and a few days with nowhere you need to be.',
        ],
      },
      exterior: {
        eyebrow: 'The van',
        title: 'Built properly. Made to be lived in.',
        body: [
          'We restored it ourselves, so we know every bolt in it.',
          "It's the one we'd take ourselves.",
        ],
      },
      amenities: {
        eyebrow: 'Living in it',
        title: 'Small outside. Everything you need inside.',
        body: [
          "The bed pulls out in one movement. There's a hot shower outside, two rings, a sink, and enough space to actually cook.",
          'Room enough to live in it, not just sleep in it.',
        ],
      },
      view: {
        eyebrow: 'Where you stop',
        title: 'Stop when you find somewhere worth staying.',
        body: [
          'No campsite to plan around. No itinerary to follow.',
          'Pull off the road, open the door, put the kettle on. The coast is right there.',
        ],
      },
      closing: {
        eyebrow: 'The keys',
        title: 'You start in A Coruña. You choose where after.',
        body: [
          'Take it for a few days, head wherever you like, and bring it back when your trip is done.',
          'We look after it ourselves, and we answer our own emails. Usually within a day.',
        ],
      },
    },
    build: {
      welcome: {
        title: 'A van built around the way you travel.',
        body: [
          'One conversion at a time, from our workshop in A Coruña.',
          'No standard layouts, no catalogue of extras. Just a van that works for you.',
        ],
      },
      engineering: {
        eyebrow: 'The build',
        title: 'We do the work ourselves.',
        body: [
          'From the first sketch to the last screw, we handle the layout, electrics, plumbing, woodwork, and all the unglamorous bits in between.',
          'You deal directly with the people doing the work.',
        ],
      },
      joinery: {
        eyebrow: 'Inside',
        title: 'Every centimetre has a job.',
        body: [
          'A bed where you actually want it, storage where you need it, a kitchen that works.',
          'We build for real use, not for a showroom.',
        ],
      },
      finish: {
        eyebrow: 'The life',
        title: 'Tell us what you want the van to do.',
        body: [
          'Weekend escapes, long trips, working from the road, surfing the coast.',
          "We'll work out what it needs, then build around it.",
        ],
      },
      closing: {
        eyebrow: 'The start',
        title: "Bring us your van. We'll build the rest.",
        body: [
          'Tell us what you have, where you want to go, and what you need it to do.',
          "We'll tell you what we'd build, what it will involve, and where we'd spend your money.",
        ],
      },
    },
  },
  es: {
    hire: {
      welcome: {
        title: 'Coge la furgo. Sigue la costa.',
        body: [
          'Una camper restaurada, el Atlántico ahí fuera y unos días sin tener que estar en ningún sitio.',
        ],
      },
      exterior: {
        eyebrow: 'La furgo',
        title: 'Bien hecha. Hecha para vivirla.',
        body: [
          'La restauramos nosotros, así que conocemos cada tornillo.',
          'Es la que nos llevaríamos nosotros.',
        ],
      },
      amenities: {
        eyebrow: 'Vivirla',
        title: 'Pequeña por fuera. Todo lo necesario dentro.',
        body: [
          'La cama se despliega de un solo movimiento. Hay ducha de agua caliente fuera, dos fuegos, fregadero y sitio de sobra para cocinar de verdad.',
          'Espacio para vivir dentro, no solo para dormir.',
        ],
      },
      view: {
        eyebrow: 'Dónde parar',
        title: 'Para cuando encuentres un sitio donde quedarte.',
        body: [
          'Sin camping que planear. Sin itinerario que seguir.',
          'Sal de la carretera, abre la puerta, pon el agua a hervir. La costa está justo ahí.',
        ],
      },
      closing: {
        eyebrow: 'Las llaves',
        title: 'Empiezas en A Coruña. Tú decides el resto.',
        body: [
          'Llévatela unos días, ve donde quieras y devuélvela cuando termine el viaje.',
          'La cuidamos nosotros y contestamos nuestros propios correos. Normalmente en menos de un día.',
        ],
      },
    },
    build: {
      welcome: {
        title: 'Una furgoneta hecha a tu manera de viajar.',
        body: [
          'Una camperización cada vez, desde nuestro taller en A Coruña.',
          'Sin distribuciones estándar ni catálogo de extras. Solo una furgo que funcione para ti.',
        ],
      },
      engineering: {
        eyebrow: 'El trabajo',
        title: 'El trabajo lo hacemos nosotros.',
        body: [
          'Del primer boceto al último tornillo: distribución, electricidad, fontanería, carpintería y todo lo poco lucido que hay en medio.',
          'Hablas directamente con quien está haciendo el trabajo.',
        ],
      },
      joinery: {
        eyebrow: 'Dentro',
        title: 'Cada centímetro tiene una función.',
        body: [
          'La cama donde de verdad la quieres, almacenaje donde hace falta, una cocina que funciona.',
          'Construimos para usarla de verdad, no para un escaparate.',
        ],
      },
      finish: {
        eyebrow: 'La vida',
        title: 'Cuéntanos qué quieres que haga la furgo.',
        body: [
          'Escapadas de fin de semana, viajes largos, trabajar desde la carretera, surfear la costa.',
          'Nosotros vemos qué necesita y construimos a partir de ahí.',
        ],
      },
      closing: {
        eyebrow: 'El principio',
        title: 'Tráenos tu furgoneta. Hacemos el resto.',
        body: [
          'Cuéntanos qué tienes, a dónde quieres ir y qué necesitas que haga.',
          'Te diremos qué construiríamos, qué implica y en qué merece la pena gastar tu dinero.',
        ],
      },
    },
  },
};
---
<section class="hero-track" id="top" data-hero-track>
  <div class="hero-stage">
    <canvas data-hero-canvas aria-hidden="true"></canvas>

    <div class="hero-stills" aria-hidden="true">
      {stationStills.map((st) => (
        st.eager ? (
          /* The landing still: a real <picture> so the browser resolves
             portrait vs landscape itself and starts fetching immediately. This
             is the first thing anyone sees, so it is the one asset worth
             prioritising. */
          <picture>
            {st.portraitSrc && <source media={PORTRAIT_MQ} srcset={st.portraitSrc} />}
            <img
              class="station-still"
              data-still-mode={st.mode}
              data-still-id={st.id}
              data-still-eager
              src={st.src}
              alt=""
              fetchpriority="high"
              loading="eager"
              decoding="async"
            />
          </picture>
        ) : (
          /* No src, so nothing is fetched until its station is close —
             attachStill picks the tier and assigns it. loading="lazy" would NOT
             achieve this on its own:
             these sit inside the viewport at opacity 0, which counts as
             visible, so the browser fetches them anyway. */
          <img
            class="station-still"
            data-still-mode={st.mode}
            data-still-id={st.id}
            data-still-src={st.src}
            data-still-portrait={st.portraitSrc}
            alt=""
            decoding="async"
          />
        )
      ))}
    </div>

    <div class="hero-loops" aria-hidden="true">
      {/* No <source> children and preload="none" on purpose. With both a .mp4
          and a .webm listed the browser fetched BOTH in full — the comment that
          used to sit here claimed an unselected source is never fetched, and
          measurement showed that is not true. Worse, the closing clip
          downloaded completely while the visitor was still at the top of a
          900vh scroll: 9.28MB of video before a single deliberate scroll,
          competing with the frames actually on screen. The script now picks ONE
          format via canPlayType and assigns it only as its station comes into
          range — see attachLoopSource below. */}
      {stationLoops.map((lp) => (
        <video
          class="station-loop"
          data-loop-mode={lp.mode}
          data-loop-id={lp.id}
          data-loop-src={lp.src}
          data-loop-poster={lp.poster}
          data-loop-poster-portrait={lp.posterPortrait}
          preload="none"
          muted
          loop
          playsinline
        ></video>
      ))}
    </div>

    <div class="hero-vignette" aria-hidden="true"></div>

    <div class="hero-copy">
      {Object.entries(copy).map(([lang, modes]) => (
        Object.entries(modes).map(([mode, sections]) => (
          Object.entries(sections).map(([id, block]) => (
            <div class="copy-block" data-copy-lang={lang} data-copy-mode={mode} data-copy-id={id}>
              {block.eyebrow && <p class="eyebrow">{block.eyebrow}</p>}
              <h2 class="serif copy-title">{block.title}</h2>
              {block.body.map((para) => <p class="copy-body">{para}</p>)}
            </div>
          ))
        ))
      ))}
    </div>

    <div class="scroll-cue" data-scroll-cue aria-hidden="true">
      <span></span>
      Scroll
    </div>

    {/* Station navigator. Left edge by necessity: the brand badge owns the
        bottom-right and the copy is centred at bottom: 12vh, so this is the only
        conflict-free region — freed up by dropping the header wordmark. */}
    <nav class="station-nav" data-station-nav aria-label="Jump to a section">
      {navStations.map((grp) => (
        <div class="nav-rail" data-nav-mode={grp.mode}>
          <span class="nav-rail-line" aria-hidden="true"></span>
          <span class="nav-rail-fill" aria-hidden="true"></span>
          {grp.items.map((it) => (
            <button
              type="button"
              class="nav-stop"
              data-nav-jump={it.id}
              data-label-en={it.labels.en}
              data-label-es={it.labels.es}
              style={`top:${it.at}%`}
              aria-label={`Go to ${it.labels.en}`}
            >
              <span class="nav-label">{it.labels.en}</span>
            </button>
          ))}
        </div>
      ))}
    </nav>

    <div class="hero-brand">
      <img
        class="hero-brand-shadow hero-brand-shadow--ambient"
        src="/logo-glow.webp"
        alt=""
        aria-hidden="true"
        width="864"
        height="838"
        loading="eager"
        decoding="async"
      />
      <img
        class="hero-brand-shadow hero-brand-shadow--contact"
        src="/logo-glow.webp"
        alt=""
        aria-hidden="true"
        width="864"
        height="838"
        loading="eager"
        decoding="async"
      />
      <img
        class="hero-brand-mark"
        src="/logo-light.webp"
        alt="Coruña Campervan"
        width="560"
        height="534"
        loading="eager"
        decoding="async"
      />
    </div>

    <pre class="debug-readout" data-debug-readout aria-hidden="true" hidden></pre>
  </div>
</section>

{/* The intro: a survey chart of Galicia that draws itself as the page loads.

    Deliberately NOT a full preloader — waiting for the whole frame sequence
    would be 21s at 25Mbps and 53s at 10Mbps. Progress is what has genuinely
    arrived (the landing still, then the opening scrub frames), and
    INTRO_MAX_MS gives up regardless so a slow connection is never trapped.

    Contours are drawn low to high, so the terrain rises out of the sea, and a
    summit's mark appears only once the survey passes its altitude. The readout
    counts metres as well as percent: the bar reads as an altitude survey
    climbing to Galicia's highest point rather than a generic loader. */}
<!-- MAX_ELEV / BAND_COUNT ride on the element: they are frontmatter, so they
     are build-time only and are not in scope inside the client script. -->
<div
  class="intro"
  data-intro
  data-max-elev={MAX_ELEV}
  data-band-count={BAND_COUNT}
  data-view-x={VIEW_X}
  data-view-y={VIEW_Y}
  data-view-w={VIEW_W}
  data-view-h={VIEW_H}
  role="presentation"
>
  <div class="intro-top">
    <div class="intro-brand serif">Coruña <em>Campervan</em></div>
    <div class="intro-meta">
      <span class="intro-meta-row"><span class="dash">—</span> Campervan hire</span>
      <span class="intro-meta-row"><span class="dash">—</span> A Coruña, Galicia</span>
      <span class="intro-meta-row"><span class="dash">—</span> Est. 2026</span>
    </div>
  </div>

  <svg
    class="intro-chart"
    viewBox={CHART_VIEWBOX}
    preserveAspectRatio="xMidYMid meet"
    aria-hidden="true"
  >
    {CHART_BANDS.map((b) => (
      b.d.map((dAttr) => (
        /* pathLength normalises every contour to 1, so the draw fraction is the
           dashoffset directly and no real path lengths are needed. */
        <path
          class={b.coast ? 'contour is-coast' : 'contour'}
          data-band={b.band}
          d={dAttr}
          pathLength="1"
        />
      ))
    ))}
  </svg>

  <div class="intro-peaks">
    {CHART_PEAKS.map((pk) => (
      <div
        class:list={['peak', pk.side === 'left' && 'is-left']}
        data-side={pk.side}
        data-peak-elev={pk.elev}
        data-x={pk.x}
        data-y={pk.y}
      >
        <svg class="peak-mark" viewBox="0 0 10 9" aria-hidden="true">
          <path d="M1 8 L5 1 L9 8 Z" />
        </svg>
        <span class="peak-text">
          <span class="peak-name">{pk.name}</span>
          <span class="peak-meta">{pk.coords}  ·  {pk.elev} m</span>
        </span>
      </div>
    ))}
  </div>

  <div class="intro-bottom">
    <div class="intro-readout">
      <span class="intro-status">GPS calibrating</span>
      <span class="intro-elev" data-intro-elev>0 m</span>
    </div>
    <div class="intro-bar"><i data-intro-bar></i></div>
    <div class="intro-count-wrap">
      <span class="intro-count serif" data-intro-count>0</span>
      <span class="intro-percent serif">%</span>
    </div>
  </div>
</div>

<style>
  .hero-track {
    position: relative;
    height: 900vh; /* total scroll distance; more = slower, more cinematic scrub */
  }
  /* ---- intro: the survey chart -----------------------------------------
     Cream, not the site's near-black. It is the fleet section's own ground, and
     it turns the sweep-up exit into a reveal: paper lifting off the footage. */
  .intro {
    position: fixed;
    inset: 0;
    z-index: 500;
    background: #ede6d8;
    color: #2e2b27;
    padding: clamp(1.5rem, 4vw, 3rem);
    overflow: hidden;
  }
  .intro[hidden] { display: none; }

  .intro-chart {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .contour {
    fill: none;
    stroke: #6f6659;
    stroke-width: 0.9;
    /* Normalised by pathLength="1", so 1 is undrawn and 0 is complete. */
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    vector-effect: non-scaling-stroke;
  }
  .contour.is-coast {
    stroke: #2e2b27;
    stroke-width: 1.5;
  }

  .intro-top {
    position: absolute;
    top: clamp(1.5rem, 4vw, 3rem);
    left: clamp(1.5rem, 4vw, 3rem);
    right: clamp(1.5rem, 4vw, 3rem);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    opacity: 0;
    animation: intro-fade-in 0.8s ease 0.1s forwards;
  }
  .intro-brand {
    font-size: clamp(1.05rem, 2.4vw, 1.5rem);
    letter-spacing: -0.02em;
  }
  .intro-brand em { font-style: italic; }
  .intro-meta {
    text-align: right;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #7d7365;
    line-height: 1.9;
  }
  .intro-meta-row { display: block; }
  .intro-meta-row .dash { color: var(--accent); margin-right: 0.45rem; }

  /* Peaks are positioned in percentages of the chart's own viewBox, so they
     stay locked to their coordinates however the SVG is scaled. */
  .intro-peaks { position: absolute; inset: 0; pointer-events: none; }
  .peak {
    position: absolute;
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    transform: translate(-4px, -6px);
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .peak[data-reached] { opacity: 1; }
  .peak-mark { width: 11px; height: 10px; flex: none; }
  .peak-mark path { fill: none; stroke: #2e2b27; stroke-width: 1.1; }
  .peak-text { display: block; line-height: 1.35; white-space: nowrap; }
  /* A close pair would overlap with both labels to the right, so the leftmost
     puts its text on the other side. The mark itself never moves. */
  .peak.is-left {
    flex-direction: row-reverse;
    transform: translate(calc(-100% + 4px), -6px);
  }
  .peak.is-left .peak-text { text-align: right; }
  .peak-name { display: block; font-size: 0.72rem; letter-spacing: 0.02em; }
  .peak-meta { display: block; font-size: 0.62rem; color: #8a8072; }

  .intro-bottom {
    position: absolute;
    bottom: clamp(1.5rem, 4vw, 3rem);
    left: clamp(1.5rem, 4vw, 3rem);
    right: clamp(1.5rem, 4vw, 3rem);
    display: flex;
    align-items: flex-end;
    gap: clamp(1rem, 3vw, 2rem);
    opacity: 0;
    animation: intro-fade-in 0.8s ease 0.25s forwards;
  }
  .intro-readout {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .intro-status { color: #8a8072; }
  .intro-elev { color: var(--accent); font-variant-numeric: tabular-nums; }
  .intro-bar {
    flex: 1;
    height: 1px;
    margin-bottom: 0.45rem;
    background: rgba(46, 43, 39, 0.16);
    overflow: hidden;
  }
  .intro-bar i {
    display: block;
    height: 100%;
    width: 0%;
    background: var(--accent);
  }
  .intro-count-wrap {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.12em;
    line-height: 0.85;
  }
  .intro-count {
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    font-style: italic;
    font-variant-numeric: tabular-nums;
  }
  .intro-percent {
    font-size: clamp(0.9rem, 1.8vw, 1.15rem);
    font-style: italic;
    color: var(--accent);
    margin-top: 0.35em;
  }

  /* Exit: chrome lifts, then the sheet sweeps up off the footage. */
  .intro.is-leaving .intro-top,
  .intro.is-leaving .intro-bottom,
  .intro.is-leaving .intro-peaks {
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.45s ease, transform 0.45s ease;
    animation: none;
  }
  .intro.is-leaving .intro-chart {
    opacity: 0;
    transition: opacity 0.55s ease 0.1s;
  }
  .intro.is-leaving {
    transform: translateY(-100%);
    transition: transform 1.05s cubic-bezier(0.76, 0, 0.24, 1) 0.42s;
  }

