    50% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(0.3); opacity: 0.3; }
  }

  /* ---- Station navigator -------------------------------------------------
     A single hairline that fills as you scroll, with a mark for each station
     and only the current station named. Left edge by necessity: the brand badge
     owns the bottom-right and the copy is centred at bottom: 12vh.
     Stops are positioned by their real scroll position (see navStations above),
     so the fill head arrives exactly on a mark as the scrub settles there. */
