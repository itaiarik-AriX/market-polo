---
import { timelines, buildTimeline } from '../lib/heroTimeline';

// Build the list of high-res station stills (only for modes that provide them).
// Each still is the SAME frame the canvas holds on, at full resolution — so it
// "sharpens in" seamlessly when the scrub settles on that station.
const stationStills = Object.entries(timelines).flatMap(([mode, tl]) =>
  tl.stationsBase
    ? tl.sections.map((s) => ({
        mode,
        id: s.id,
        src: `${tl.stationsBase}${s.id}.${tl.stationsExt ?? tl.ext}`,
      }))
    : []
);

// Ambient loops, for the stations that declare one (see Section.loop). The clip
// opens on the same frame the canvas holds on, so it can crossfade against an
// identical image rather than against motion.
const stationLoops = Object.entries(timelines).flatMap(([mode, tl]) =>
  tl.sections
    .filter((s) => s.loop)
    .map((s) => ({
      mode,
      id: s.id,
      src: s.loop!,
      // Poster is that station's own still, so there is never a blank frame
      // while the clip arrives — and it is already being fetched for the
      // .station-still layer, so it costs nothing extra.
      poster: tl.stationsBase
        ? `${tl.stationsBase}${s.id}.${tl.stationsExt ?? tl.ext}`
        : undefined,
      // Only the station the page lands on is worth fetching up front.
      eager: tl.sections[0].id === s.id,
    }))
);

// Short labels for the station navigator — the copy headlines are far too long
// to sit in a rail. Keyed the same way as `copy` below.
const navLabels: Record<string, Record<string, string>> = {
  hire: {
    welcome: 'Welcome',
    exterior: 'The van',
    amenities: 'Inside',
    view: 'The view',
    closing: 'Ready',
  },
  build: {
    welcome: 'Welcome',
    engineering: 'Engineering',
    joinery: 'Joinery',
    finish: 'The finish',
    closing: 'Ready',
  },
};

// Each stop is placed at its TRUE scroll position, not spread evenly down the
// rail. The stations are not equally spaced in scroll — holds and motions carry
// different weights — so evenly-spaced marks would sit up to 16px away from
// where the fill head actually arrives, which on a progress bar reads as broken.
// buildTimeline is the same function the scrubber uses, so the two cannot drift.
const navStations = Object.entries(timelines).map(([mode, tl]) => {
  const ranges = Object.fromEntries(
    buildTimeline(tl).sectionRanges.map((r) => [r.id, r])
  );
  return {
    mode,
    items: tl.sections.map((s) => {
      const r = ranges[s.id];
      return {
        id: s.id,
        label: navLabels[mode]?.[s.id] ?? s.id,
        at: (((r.start + r.end) / 2) * 100).toFixed(2),
      };
    }),
  };
});

// Copy is keyed by section id (see src/lib/heroTimeline.ts). Each block fades in
// while the sequence holds on that section's frame.
const copy = {
  hire: {
    welcome: {
      eyebrow: 'Coruña Campervan',
      title: 'Wake up somewhere the map forgot.',
      body: 'A classic camper, the open coast, and nowhere you have to be.',
    },
    exterior: {
      eyebrow: 'The van',
      title: 'A classic, through and through.',
      body: 'Restored, road-ready, and unmistakably retro — inside and out.',
    },
    amenities: {
      eyebrow: 'What’s inside',
      title: 'Everything you need for the road.',
      body: 'A proper bed, a hot side shower, and a full kitchen — all in reach.',
    },
    view: {
      eyebrow: 'Pull over anywhere',
      title: 'Wherever you stop, that’s the view.',
      body: 'No campsite required — just a spot you like the look of.',
    },
    closing: {
      eyebrow: 'Ready?',
      title: 'Ready to hit the road?',
      body: 'Tell us your dates below — we’ll write back personally.',
    },
  },
  build: {
    welcome: {
      eyebrow: 'Coruña Campervan',
      title: 'Every camper starts as steel and imagination.',
      body: 'This is where your build begins.',
    },
    engineering: {
      eyebrow: 'Engineering',
      title: 'Engineered underneath.',
      body: 'Insulation, electrics and systems done properly — so nothing lets you down.',
    },
    joinery: {
      eyebrow: 'Craftsmanship',
      title: 'Bespoke joinery, built by hand.',
      body: 'Every cabinet fitted to your van, not a generic kit.',
    },
    finish: {
      eyebrow: 'The finish',
      title: 'Finished to live in, not just to look at.',
      body: 'A complete build, ready for the road.',
    },
    closing: {
      eyebrow: 'Ready?',
      title: 'Ready to build yours?',
      body: 'Tell us what you have in mind below.',
    },
  },
};
---
<section class="hero-track" id="top" data-hero-track>
  <div class="hero-stage">
    <canvas data-hero-canvas aria-hidden="true"></canvas>

    <div class="hero-stills" aria-hidden="true">
      {stationStills.map((st) => (
        <img
          class="station-still"
          data-still-mode={st.mode}
          data-still-id={st.id}
          src={st.src}
          alt=""
          loading="eager"
          decoding="async"
        />
      ))}
    </div>

    <div class="hero-loops" aria-hidden="true">
      {stationLoops.map((lp) => (
        <video
          class="station-loop"
          data-loop-mode={lp.mode}
          data-loop-id={lp.id}
          poster={lp.poster}
          preload={lp.eager ? 'auto' : 'metadata'}
          muted
          loop
          playsinline
        >
          {/* H.264 first: on this footage it beat VP9 on quality per byte
              (1.8MB at 39.7dB against 2.2MB at 38.5dB), and every current
              browser takes it — a source that is not selected is never
              fetched, so the VP9 below costs real visitors nothing. It is
              there for clients without H.264, which includes the headless
              Chromium this is regression-tested in. */}
          <source src={`${lp.src}.mp4`} type="video/mp4" />
          <source src={`${lp.src}.webm`} type="video/webm" />
        </video>
      ))}
    </div>

    <div class="hero-vignette" aria-hidden="true"></div>

    <div class="hero-copy">
      {Object.entries(copy).map(([mode, sections]) => (
        Object.entries(sections).map(([id, block]) => (
          <div class="copy-block" data-copy-mode={mode} data-copy-id={id}>
            <p class="eyebrow">{block.eyebrow}</p>
            <h2 class="serif copy-title">{block.title}</h2>
            <p class="copy-body">{block.body}</p>
          </div>
        ))
      ))}
    </div>

    <div class="scroll-cue" data-scroll-cue aria-hidden="true">
      <span></span>
      Scroll
    </div>

    {/* Station navigator. Left edge by necessity: the brand badge owns the
        bottom-right and the copy is centred at bottom: 12vh, so this is the only
        conflict-free region — freed up by dropping the header wordmark. */}
    <nav class="station-nav" data-station-nav aria-label="Jump to a section">
      {navStations.map((grp) => (
        <div class="nav-rail" data-nav-mode={grp.mode}>
          <span class="nav-rail-line" aria-hidden="true"></span>
          <span class="nav-rail-fill" aria-hidden="true"></span>
          {grp.items.map((it) => (
            <button
              type="button"
              class="nav-stop"
              data-nav-jump={it.id}
              style={`top:${it.at}%`}
              aria-label={`Go to ${it.label}`}
            >
              <span class="nav-label">{it.label}</span>
            </button>
          ))}
        </div>
      ))}
    </nav>

    <div class="hero-brand">
      <img
        class="hero-brand-shadow hero-brand-shadow--ambient"
        src="/logo-glow.webp"
        alt=""
        aria-hidden="true"
        width="864"
        height="838"
        loading="eager"
        decoding="async"
      />
      <img
        class="hero-brand-shadow hero-brand-shadow--contact"
        src="/logo-glow.webp"
        alt=""
        aria-hidden="true"
        width="864"
        height="838"
        loading="eager"
        decoding="async"
      />
      <img
        class="hero-brand-mark"
        src="/logo-light.webp"
        alt="Coruña Campervan"
        width="560"
        height="534"
        loading="eager"
        decoding="async"
      />
    </div>

    <pre class="debug-readout" data-debug-readout aria-hidden="true" hidden></pre>
  </div>
</section>

<style>
  .hero-track {
    position: relative;
    height: 900vh; /* total scroll distance; more = slower, more cinematic scrub */
  }
  .hero-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    background: var(--bg);
  }
  .hero-stage canvas {
    position: absolute;
    inset: 0;
    display: block;
  }
  .hero-stills {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .station-still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    will-change: opacity;
  }
  /* Ambient station loops, layered directly over the stills with identical
     cover geometry so the two are pixel-aligned and can crossfade cleanly. */
  .hero-loops {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .station-loop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    will-change: opacity;
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.42) 0%, rgba(0, 0, 0, 0) 26%, rgba(0, 0, 0, 0) 58%, rgba(0, 0, 0, 0.62) 100%);
    pointer-events: none;
  }

  .hero-copy {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .copy-block {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12vh;
    padding: 0 2rem;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    opacity: 0;
    transform: translateY(18px);
    will-change: opacity, transform;
  }
  .copy-block .eyebrow {
    margin-bottom: 0.9rem;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.7);
  }
  .copy-title {
    font-weight: 400;
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--fg);
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.6);
  }
  .copy-body {
    margin-top: 1rem;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    color: var(--fg);
    opacity: 0.92;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.7);
  }

  .scroll-cue {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-dim);
    transition: opacity 0.4s ease;
  }
  .scroll-cue span {
    width: 1px;
    height: 32px;
    background: linear-gradient(180deg, var(--fg-dim), transparent);
    animation: scroll-cue-move 1.8s ease-in-out infinite;
  }
  @keyframes scroll-cue-move {
    0% { transform: scaleY(0.3); opacity: 0.3; }
    50% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(0.3); opacity: 0.3; }
  }

  /* ---- Station navigator -------------------------------------------------
     A single hairline that fills as you scroll, with a mark for each station
     and only the current station named. Left edge by necessity: the brand badge
     owns the bottom-right and the copy is centred at bottom: 12vh.
     Stops are positioned by their real scroll position (see navStations above),
     so the fill head arrives exactly on a mark as the scrub settles there. */
  .station-nav {
    position: absolute;
    left: clamp(0.9rem, 2.4vw, 2.2rem);
    top: 50%;
    transform: translateY(-50%);
    z-index: 12;
  }
  .nav-rail {
    position: relative;
    width: 2px;
    height: min(30vh, 250px);
  }
  .nav-rail[hidden] { display: none; }
  .nav-rail-line,
  .nav-rail-fill {
    position: absolute;
    left: 0;
    width: 100%;
    border-radius: 2px;
  }
  .nav-rail-line {
    top: 0;
    bottom: 0;
    background: rgba(245, 241, 232, 0.18);
  }
  .nav-rail-fill {
    top: 0;
    height: var(--nav-progress, 0%);
    background: var(--accent);
    box-shadow: 0 0 10px rgba(224, 137, 79, 0.45);
  }
  /* No visible mark any more — the fill head shows position and the label
     names it. The button still needs a real hit area, so it keeps its size
     without drawing anything. */
  .nav-stop {
    position: absolute;
    left: 0;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    background: none;
    border: none;
    padding: 0.55rem 0.5rem 0.55rem 0.85rem;
    margin-left: -0.5rem;
    min-width: 2.75rem;
    cursor: pointer;
    font: inherit;
    color: var(--fg);
    -webkit-tap-highlight-color: transparent;
  }
  .nav-label {
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.75);
  }
  .nav-stop.is-active .nav-label {
    opacity: 0.95;
    transform: none;
  }
  .nav-stop:hover .nav-label {
    opacity: 0.65;
    transform: none;
  }

  /* Touch: marks only, and stops that clear 44px without overlapping. */
  @media (max-width: 640px) {
    .station-nav { left: 0.75rem; }
    .nav-rail { height: min(38vh, 300px); }
    .nav-stop {
      padding: 0.8rem 0.7rem;
      margin-left: -0.7rem;
      min-width: 44px;
      min-height: 44px;
    }
    .nav-label { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-label, .nav-rail-fill { transition: none; }
  }

  /* Brand badge, bottom-right, sitting in its own soft shadow.
     The shadow is the logo's OWN silhouette — the line-art strokes closed up,
     the exterior flood-filled, then feathered — so it falls in the badge's
     shape rather than as a rectangle behind it.
     Kept as live DOM rather than baked into the frames so it stays crisp at any
     DPR and is never cropped by the canvas's object-fit: cover.
     Note: the frames are untouched footage. This shadow is sized for looks, not
     to cover the source's burned-in tool marks — those are visible again in
     this corner on landscape screens (portrait crops them off entirely). */
  .hero-brand {
    position: absolute;
    right: 4vw;
    bottom: 6vh;
    height: clamp(84px, 13.5vh, 160px);
    aspect-ratio: 560 / 534;
    pointer-events: none;
  }

  /* A real cast shadow rather than a dark patch, so the badge reads as an
     object sitting above the picture.
     Two layers, which is what sells the depth: a tight CONTACT shadow hugging
     the badge (short offset, small spread, the darker of the two) and a wide
     AMBIENT one falling further away (longer offset, much softer, fainter).
     A single shadow always looks like a sticker; the pair reads as lit.
     Both use multiply, so the backdrop is scaled rather than painted over —
     the shade picks up the grass's warmth or the van's blue by itself instead
     of going grey-black on top of it. Offsets go down and right throughout,
     which puts the light up and to the left, matching the footage. */
  .hero-brand-shadow {
    position: absolute;
    left: 50%;
    top: 50%;
    height: auto;
    /* No will-change here: these layers never animate, and promoting them would
       only add a compositing layer for the blend to read back through. */
    mix-blend-mode: multiply;
  }
  .hero-brand-shadow--ambient {
    width: 168%;
    transform: translate(calc(-50% + 2.5%), calc(-50% + 7%));
    opacity: 0.5;
  }
  .hero-brand-shadow--contact {
    width: 116%;
    transform: translate(calc(-50% + 1%), calc(-50% + 3%));
    opacity: 0.62;
  }
  .hero-brand-mark {
    position: relative; /* above the glow */
    display: block;
    height: 100%;
    width: auto;
    opacity: 0.95;
  }

  @media (max-width: 640px) {
    .copy-block { bottom: 14vh; }
    /* Smaller on phones so it never crowds the copy */
    .hero-brand {
      height: clamp(66px, 10vh, 104px);
      right: 5vw;
      bottom: 4.5vh;
    }
  }

  /* Temporary diagnostic readout, opt-in only via ?debug=1 — never shown to a
     real visitor. Remove once no longer needed. */
  .debug-readout {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 20;
    margin: 0;
    padding: 0.6rem 0.8rem;
    background: rgba(0, 0, 0, 0.75);
    color: #7CFC9A;
    font-size: 0.72rem;
    line-height: 1.5;
    border-radius: 6px;
    pointer-events: none;
    white-space: pre;
  }
</style>

<script>
  import { createScrollScrubber } from '../lib/scrollScrubber';
  import { timelines } from '../lib/heroTimeline';
  import type { SectionRange } from '../lib/heroTimeline';

  function initHero() {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    const track = document.querySelector<HTMLElement>('[data-hero-track]');
    const scrollCue = document.querySelector<HTMLElement>('[data-scroll-cue]');
    const blocks = Array.from(document.querySelectorAll<HTMLElement>('.copy-block'));
    const stills = Array.from(document.querySelectorAll<HTMLElement>('.station-still'));
    let loops = Array.from(document.querySelectorAll<HTMLVideoElement>('.station-loop'));
    const nav = document.querySelector<HTMLElement>('[data-station-nav]');
    const navRails = Array.from(document.querySelectorAll<HTMLElement>('.nav-rail'));
    // Declared up here, not beside the click handler: onProgress fires from
    // inside createScrollScrubber below, so anything it touches has to be
    // initialised before that call rather than after it.
    let latestRanges: Record<string, SectionRange> = {};
    if (!canvas || !track) return;


    // The loops are decoration. Drop them entirely when the visitor has asked
    // for less motion, or when the browser reports a metered or slow connection
    // — the sharp stills underneath already carry every station on their own.
    const conn = (navigator as any).connection;
    const ambientWanted =
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
      !(conn && (conn.saveData || /(^|\W)(slow-)?2g$/.test(conn.effectiveType ?? '')));
    if (!ambientWanted) {
      for (const v of loops) v.remove();
      loops = [];
    }

    // Fade a section's copy/still in over the first slice of its hold and out over the last.
    const EDGE = 0.28; // fraction of each hold used for the fade in/out

    const EPS = 1e-6;

    function opacityForRange(p: number, start: number, end: number): number {
      // Tolerant bounds: the ranges are built by accumulating fractions, so the
      // last one ends at 0.9999999999999999 rather than 1. Without the epsilon,
      // progress of exactly 1 falls outside it and the closing station blanks
      // at the very bottom of the track.
      if (p < start - EPS || p > end + EPS) return 0;
      const span = end - start;
      const edge = span * EDGE;
      // A hold pinned to either end of the timeline has nothing to fade from or
      // to: progress 0 is where the page loads and 1 is where it ends. Ramping
      // there would leave the first station's copy — and its ambient loop —
      // invisible on arrival, appearing only once the visitor starts scrolling.
      const atStart = start <= EPS;
      const atEnd = end >= 1 - EPS;
      if (!atStart && p < start + edge) return (p - start) / edge;
      if (!atEnd && p > end - edge) return (end - p) / edge;
      return 1;
    }

    const scrubber = createScrollScrubber({
      canvas,
      track,
      timelines,
      initialMode: 'hire',
      onProgress(progress, mode, ranges: SectionRange[]) {
        if (scrollCue) scrollCue.style.opacity = progress > 0.02 ? '0' : '1';
        const rangeById: Record<string, SectionRange> = {};
        for (const r of ranges) rangeById[r.id] = r;
        latestRanges = rangeById;
        updateNav(progress, mode, rangeById);

        for (const block of blocks) {
          if (block.dataset.copyMode !== mode) {
            block.style.opacity = '0';
            continue;
          }
          const r = rangeById[block.dataset.copyId!];
          const o = r ? opacityForRange(progress, r.start, r.end) : 0;
          block.style.opacity = String(o);
          block.style.transform = `translateY(${(1 - o) * 18}px)`;
        }

        // Sharp full-resolution still fades in as the scrub settles on its
        // station, hiding the (softer) scrub frame exactly where the user
        // dwells and reads.
        for (const still of stills) {
          if (still.dataset.stillMode !== mode) {
            still.style.opacity = '0';
            continue;
          }
          const r = rangeById[still.dataset.stillId!];
          still.style.opacity = r ? String(opacityForRange(progress, r.start, r.end)) : '0';
        }

        // Ambient loop rides the same curve as its still, so the handover is a
        // pure function of scroll position — scroll back up mid-fade and it
        // fades back in. Nothing animates on its own, nothing to wait out.
        for (const v of loops) {
          if (v.dataset.loopMode !== mode) {
            v.style.opacity = '0';
            stopLoop(v);
            continue;
          }
          const r = rangeById[v.dataset.loopId!];
          const o = r ? opacityForRange(progress, r.start, r.end) : 0;
          v.style.opacity = String(o);
          // Decode only while it is actually visible: by the time the canvas
          // starts scrubbing, every loop is paused.
          if (o > 0) startLoop(v);
          else stopLoop(v);
        }
      },
    });

    if (nav) {
      // Jumping the page is allowed HERE and nowhere else. What was removed from
      // this component was the page moving on the user's behalf after a gesture;
      // a jump in direct response to a click is the user asking to be moved.
      nav.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-nav-jump]');
        if (!btn) return;
        const r = latestRanges[btn.dataset.navJump!];
        if (!r) return;
        const scrollable = track!.getBoundingClientRect().height - window.innerHeight;
        if (scrollable <= 0) return;
        const centre = (r.start + r.end) / 2;
        const top = Math.round(track!.offsetTop + centre * scrollable);
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top, behavior: reduced ? 'auto' : 'smooth' });
      });
    }

    function updateNav(progress: number, mode: string, rangeById: Record<string, SectionRange>) {
      if (!nav) return;
      // The fill is raw scroll progress, and each stop is pinned to its own true
      // position, so the head reaches a mark exactly as the scrub settles there.
      nav.style.setProperty('--nav-progress', `${(progress * 100).toFixed(2)}%`);
      for (const rail of navRails) {
        const isMode = rail.dataset.navMode === mode;
        rail.hidden = !isMode;
        if (!isMode) continue;
        for (const stop of Array.from(rail.querySelectorAll<HTMLElement>('.nav-stop'))) {
          const r = rangeById[stop.dataset.navJump!];
          // Active only while the scrub is genuinely resting on that station.
          // Mid-motion nothing lights up: snapping the marker to the nearest
          // station would claim the user is somewhere they are not.
          const active = !!r && progress >= r.start - EPS && progress <= r.end + EPS;
          stop.classList.toggle('is-active', active);
          stop.setAttribute('aria-current', active ? 'true' : 'false');
        }
      }
    }

    // play()/pause() are async and interrupt each other if called while one is
    // still settling, so gate on our own intent rather than on v.paused.
    function startLoop(v: HTMLVideoElement) {
      if (v.dataset.playing === '1') return;
      v.dataset.playing = '1';
      // A rejection here just means autoplay was refused; the poster and the
      // still underneath already show the right frame, so there is nothing to do.
      v.play().catch(() => {});
    }
    function stopLoop(v: HTMLVideoElement) {
      if (v.dataset.playing !== '1') return;
      v.dataset.playing = '';
      v.pause();
    }

    document.addEventListener('mode-change', (e: Event) => {
      const { mode } = (e as CustomEvent).detail;
      scrubber.setMode(mode);
    });

    // NOTE: there is deliberately NO scroll manipulation here — no magnetic
    // snap, no scrollIntoView, no wheel/touch preventDefault, no stepping.
    // The page scrolls natively and the user is always in full control; the
    // canvas simply reflects wherever they are. Anything that moves the page
    // on the user's behalf is what made earlier versions feel like they were
    // fighting back, so it stays out.

    // Temporary ?debug=1 on-screen readout — off by default, only active when
    // explicitly requested in the URL, so it never appears for a real visitor.
    if (new URLSearchParams(window.location.search).get('debug') === '1') {
      const readout = document.querySelector<HTMLElement>('[data-debug-readout]');
      if (readout) {
        readout.hidden = false;
        const tick = () => {
          const s = scrubber.getDebugState();
          readout.textContent = [
            `mode=${s.mode}  progress=${s.progress.toFixed(3)}`,
            `frame wanted=${s.desiredFrame}  drawn=${s.drawnFrame}`,
            `loaded=${s.loadedCount}/${s.frameCount}`,
          ].join('\n');
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }
  }

  initHero();
</script>
