---
import { BOOKING_URL } from '../lib/site';
---
<header class="site-header">
  <div class="header-inner">
    <div class="header-left">
      <div class="lang-toggle" role="tablist" aria-label="Select language">
        <button type="button" class="lang-btn" data-lang-btn="en" role="tab" aria-selected="true">EN</button>
        <button type="button" class="lang-btn" data-lang-btn="es" role="tab" aria-selected="false">ES</button>
      </div>
    </div>

    <div class="mode-toggle" role="tablist" aria-label="Hire or build a campervan">
      <button type="button" class="mode-btn" data-mode-btn="hire" role="tab" aria-selected="true">Hire</button>
      <button type="button" class="mode-btn" data-mode-btn="build" role="tab" aria-selected="false">Build</button>
      <span class="mode-indicator" data-mode-indicator aria-hidden="true"></span>
    </div>

    <a
      class="book-link"
      href={BOOKING_URL}
      target="_blank"
      rel="noopener noreferrer"
    >Book<span class="book-arrow" aria-hidden="true">&rarr;</span></a>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding-top: env(safe-area-inset-top, 0);
  }
  /* Three columns with equal outer tracks, so the toggle in the middle sits on
     the true centre of the viewport no matter how wide the action beside it
     grows. The old flex/space-between layout balanced the toggle between the
     wordmark and the link instead, which put it ~50px right of centre — and
     simply deleting the wordmark would have thrown it just as far left.
     No max-width: the action is meant to sit near the actual screen corner. */
  .header-inner {
    padding: 1.25rem clamp(1rem, 3vw, 2.5rem);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .header-left {
    display: flex;
    align-items: center;
  }

  .lang-toggle {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lang-btn {
    border: none;
    background: transparent;
    color: var(--fg-dim);
    font-size: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    font-weight: 500;
    padding: 0.25rem 0;
    cursor: pointer;
    transition: color 0.25s ease;
  }

  .lang-btn:first-child::after {
    content: '';
    display: inline-block;
    width: 1px;
    height: 14px;
    background: rgba(245, 241, 232, 0.2);
    margin-left: 0.5rem;
    vertical-align: middle;
  }

  .lang-btn[aria-selected='true'] {
    color: var(--accent);
  }

  .lang-btn:hover {
    color: var(--accent);
  }

  /* Over a light band (the fleet), the cream text and its dark text-shadow both
     stop working. Swap to dark ink for the duration. The mode toggle is exempt:
     it carries its own dark glass background, so it reads on either ground. */
  .site-header.on-light .lang-btn {
    color: rgba(36, 26, 18, 0.6);
  }
  .site-header.on-light .lang-btn[aria-selected='true'],
  .site-header.on-light .lang-btn:hover {
    color: var(--accent-deep);
  }
  .site-header.on-light .lang-btn:first-child::after {
    background: rgba(36, 26, 18, 0.22);
  }
  .site-header.on-light .book-link {
    color: #241a12;
    text-shadow: none;
  }
  .site-header.on-light .book-link:hover {
    color: var(--accent-deep);
  }

  /* Plain text, no chrome — the toggle is the only object in the header, and a
     second bordered shape beside it was competing with it. Keeps a 40px tap
     height without drawing a box. */
  .book-link {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--fg);
    white-space: nowrap;
    padding: 0.5rem 0;
    min-height: 40px;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.55);
    transition: color 0.25s ease;
  }
  .book-link:hover {
    color: var(--accent);
  }
  .book-arrow {
    transition: transform 0.25s ease;
  }
  .book-link:hover .book-arrow {
    transform: translateX(2px);
  }

  .mode-toggle {
    position: relative;
    display: inline-flex;
    background: rgba(11, 12, 13, 0.55);
    border: 1px solid rgba(245, 241, 232, 0.22);
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    border-radius: 999px;
    padding: 0.3rem;
    gap: 0.15rem;
  }
  .mode-indicator {
    position: absolute;
    top: 0.3rem;
    left: 0.3rem;
    height: calc(100% - 0.6rem);
    width: calc(50% - 0.3rem);
    background: var(--accent);
    border-radius: 999px;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
    z-index: 0;
  }
  .mode-toggle[data-active='build'] .mode-indicator {
    transform: translateX(100%);
  }
  .mode-btn {
    position: relative;
    z-index: 1;
    border: none;
    background: transparent;
    color: var(--fg);
    font-size: 0.88rem;
    font-weight: 500;
    padding: 0.55rem 1.4rem;
    min-height: 40px;
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.25s ease;
    opacity: 0.75;
  }
  .mode-btn[aria-selected='true'] {
    opacity: 1;
    color: #1a1206;
  }

  @media (max-width: 640px) {
    .header-inner {
      padding: 1rem;
      gap: 0.5rem;
    }
    .mode-btn,
    .lang-btn {
      padding: 0.55rem 1rem;
      font-size: 0.8rem;
    }
    /* Stays visible here: it is the primary call to action now, and the old
       rule hid it entirely below this width. */
    .book-link {
      font-size: 0.8rem;
    }
  }
</style>

<script>
  function initToggles() {
    // Language toggle
    const langToggle = document.querySelector<HTMLElement>('.lang-toggle');
    const langButtons = document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]');
    if (langToggle) {
      function setLanguage(lang: string) {
        langToggle!.setAttribute('data-active', lang);
        langButtons.forEach((btn) => {
          btn.setAttribute('aria-selected', String(btn.dataset.langBtn === lang));
        });
        localStorage.setItem('lang', lang);
        document.dispatchEvent(new CustomEvent('language-change', { detail: { lang } }));
      }

      langButtons.forEach((btn) => {
        btn.addEventListener('click', () => setLanguage(btn.dataset.langBtn!));
      });

      // Restore from localStorage or default to 'en'
      const saved = localStorage.getItem('lang') || 'en';
      setLanguage(saved);
    }

    // Mode toggle
    const modeToggle = document.querySelector<HTMLElement>('.mode-toggle');
    const modeButtons = document.querySelectorAll<HTMLButtonElement>('[data-mode-btn]');
    if (!modeToggle) return;

    function setActive(mode: string) {
      modeToggle!.setAttribute('data-active', mode);
      modeButtons.forEach((btn) => {
        btn.setAttribute('aria-selected', String(btn.dataset.modeBtn === mode));
      });
      document.dispatchEvent(new CustomEvent('mode-change', { detail: { mode } }));
    }

    modeButtons.forEach((btn) => {
      btn.addEventListener('click', () => setActive(btn.dataset.modeBtn!));
    });

    setActive('hire');
  }

  // Flip the header to dark ink while it overlaps a light band. Done with an
  // IntersectionObserver rather than a scroll listener on purpose: this page's
  // whole character is a scroll-scrubbed canvas, and adding per-scroll work to
  // support a colour swap would be a bad trade. The observer's root is squeezed
  // to a thin strip at the header's own height, so it fires exactly when a
  // light section arrives under the header rather than when it enters view.
  function initHeaderContrast() {
    const header = document.querySelector<HTMLElement>('.site-header');
    const lights = document.querySelectorAll<HTMLElement>('[data-light-section]');
    if (!header || !lights.length) return;

    let observer: IntersectionObserver | null = null;
    const overlapping = new Set<Element>();

    function build() {
      observer?.disconnect();
      overlapping.clear();
      const strip = Math.max(1, header!.getBoundingClientRect().height);
      observer = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            // A hidden section reports zero size and would otherwise latch on.
            if (e.isIntersecting && (e.target as HTMLElement).offsetParent !== null) {
              overlapping.add(e.target);
            } else {
              overlapping.delete(e.target);
            }
          }
          header!.classList.toggle('on-light', overlapping.size > 0);
        },
        { rootMargin: `0px 0px ${-(window.innerHeight - strip)}px 0px`, threshold: 0 }
      );
      for (const el of lights) observer.observe(el);
    }

    build();
    // The strip is measured in pixels, so it has to be rebuilt when the
    // viewport height changes.
    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(build, 150);
    });
    // Sections hide and show with the mode toggle; re-evaluate when that happens.
    document.addEventListener('mode-change', () => setTimeout(build, 0));
  }

  initToggles();
  initHeaderContrast();
</script>
