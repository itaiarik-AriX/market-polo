---
---
<header class="site-header">
  <div class="header-inner">
    <a href="#top" class="wordmark" aria-label="Coruña Campervan — home">Coruña <em>Campervan</em></a>

    <div class="mode-toggle" role="tablist" aria-label="Hire or build a campervan">
      <button type="button" class="mode-btn" data-mode-btn="hire" role="tab" aria-selected="true">Hire</button>
      <button type="button" class="mode-btn" data-mode-btn="build" role="tab" aria-selected="false">Build</button>
      <span class="mode-indicator" data-mode-indicator aria-hidden="true"></span>
    </div>

    <a href="#enquire" class="nav-link">Enquire &rarr;</a>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding-top: env(safe-area-inset-top, 0);
  }
  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.25rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }
  .wordmark {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-weight: 400;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    color: var(--fg);
    white-space: nowrap;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5);
  }
  .nav-link {
    font-size: 0.9rem;
    color: var(--fg);
    opacity: 0.85;
    padding: 0.5rem 0;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5);
    transition: opacity 0.25s ease;
  }
  .nav-link:hover {
    opacity: 1;
  }

  .mode-toggle {
    position: relative;
    display: inline-flex;
    background: rgba(11, 12, 13, 0.55);
    border: 1px solid rgba(245, 241, 232, 0.22);
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    border-radius: 999px;
    padding: 0.3rem;
    gap: 0.15rem;
  }
  .mode-indicator {
    position: absolute;
    top: 0.3rem;
    left: 0.3rem;
    height: calc(100% - 0.6rem);
    width: calc(50% - 0.3rem);
    background: var(--accent);
    border-radius: 999px;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
    z-index: 0;
  }
  .mode-toggle[data-active='build'] .mode-indicator {
    transform: translateX(100%);
  }
  .mode-btn {
    position: relative;
    z-index: 1;
    border: none;
    background: transparent;
    color: var(--fg);
    font-size: 0.88rem;
    font-weight: 500;
    padding: 0.55rem 1.4rem;
    min-height: 40px;
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.25s ease;
    opacity: 0.75;
  }
  .mode-btn[aria-selected='true'] {
    opacity: 1;
    color: #1a1206;
  }

  @media (max-width: 640px) {
    .header-inner {
      padding: 1rem;
    }
    .wordmark {
      font-size: 1.05rem;
    }
    .nav-link {
      display: none;
    }
  }
</style>

<script>
  function initModeToggle() {
    const toggle = document.querySelector<HTMLElement>('.mode-toggle');
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-mode-btn]');
    if (!toggle) return;

    function setActive(mode: string) {
      toggle!.setAttribute('data-active', mode);
      buttons.forEach((btn) => {
        btn.setAttribute('aria-selected', String(btn.dataset.modeBtn === mode));
      });
      document.dispatchEvent(new CustomEvent('mode-change', { detail: { mode } }));
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => setActive(btn.dataset.modeBtn!));
    });

    setActive('hire');
  }

  initModeToggle();
</script>
