---
// Third-party booking lives off-site; single source of truth for the link is
// Enquire.astro. Kept in sync by hand — it is one URL in two places.
const BOOKING_URL = '#';
---
<header class="site-header">
  <div class="header-inner">
    <div class="header-left">
      <div class="lang-toggle" role="tablist" aria-label="Select language">
        <button type="button" class="lang-btn" data-lang-btn="en" role="tab" aria-selected="true">EN</button>
        <button type="button" class="lang-btn" data-lang-btn="es" role="tab" aria-selected="false">ES</button>
        <span class="lang-indicator" data-lang-indicator aria-hidden="true"></span>
      </div>
    </div>

    <div class="mode-toggle" role="tablist" aria-label="Hire or build a campervan">
      <button type="button" class="mode-btn" data-mode-btn="hire" role="tab" aria-selected="true">Hire</button>
      <button type="button" class="mode-btn" data-mode-btn="build" role="tab" aria-selected="false">Build</button>
      <span class="mode-indicator" data-mode-indicator aria-hidden="true"></span>
    </div>

    <a
      class="book-link"
      href={BOOKING_URL}
      target="_blank"
      rel="noopener noreferrer"
    >Book<span class="book-arrow" aria-hidden="true">&rarr;</span></a>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding-top: env(safe-area-inset-top, 0);
  }
  /* Three columns with equal outer tracks, so the toggle in the middle sits on
     the true centre of the viewport no matter how wide the action beside it
     grows. The old flex/space-between layout balanced the toggle between the
     wordmark and the link instead, which put it ~50px right of centre — and
     simply deleting the wordmark would have thrown it just as far left.
     No max-width: the action is meant to sit near the actual screen corner. */
  .header-inner {
    padding: 1.25rem clamp(1rem, 3vw, 2.5rem);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .header-left {
    display: flex;
    align-items: center;
  }

  .lang-toggle {
    position: relative;
    display: inline-flex;
    background: rgba(11, 12, 13, 0.55);
    border: 1px solid rgba(245, 241, 232, 0.22);
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    border-radius: 999px;
    padding: 0.3rem;
    gap: 0.15rem;
  }
  .lang-indicator {
    position: absolute;
    top: 0.3rem;
    left: 0.3rem;
    height: calc(100% - 0.6rem);
    width: calc(50% - 0.3rem);
    background: var(--accent);
    border-radius: 999px;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
    z-index: 0;
  }
  .lang-toggle[data-active='es'] .lang-indicator {
    transform: translateX(100%);
  }
  .lang-btn {
    position: relative;
    z-index: 1;
    border: none;
    background: transparent;
    color: var(--fg);
    font-size: 0.88rem;
    font-weight: 500;
    padding: 0.55rem 1.1rem;
    min-height: 40px;
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.25s ease;
    opacity: 0.75;
  }
  .lang-btn[aria-selected='true'] {
    opacity: 1;
    color: #1a1206;
  }

  /* Plain text, no chrome — the toggle is the only object in the header, and a
     second bordered shape beside it was competing with it. Keeps a 40px tap
     height without drawing a box. */
  .book-link {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--fg);
    white-space: nowrap;
    padding: 0.5rem 0;
    min-height: 40px;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.55);
    transition: color 0.25s ease;
  }
  .book-link:hover {
    color: var(--accent);
  }
  .book-arrow {
    transition: transform 0.25s ease;
  }
  .book-link:hover .book-arrow {
    transform: translateX(2px);
  }

  .mode-toggle {
    position: relative;
    display: inline-flex;
    background: rgba(11, 12, 13, 0.55);
    border: 1px solid rgba(245, 241, 232, 0.22);
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    border-radius: 999px;
    padding: 0.3rem;
    gap: 0.15rem;
  }
  .mode-indicator {
    position: absolute;
    top: 0.3rem;
    left: 0.3rem;
    height: calc(100% - 0.6rem);
    width: calc(50% - 0.3rem);
    background: var(--accent);
    border-radius: 999px;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
    z-index: 0;
  }
  .mode-toggle[data-active='build'] .mode-indicator {
    transform: translateX(100%);
  }
  .mode-btn {
    position: relative;
    z-index: 1;
    border: none;
    background: transparent;
    color: var(--fg);
    font-size: 0.88rem;
    font-weight: 500;
    padding: 0.55rem 1.4rem;
    min-height: 40px;
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.25s ease;
    opacity: 0.75;
  }
  .mode-btn[aria-selected='true'] {
    opacity: 1;
    color: #1a1206;
  }

  @media (max-width: 640px) {
    .header-inner {
      padding: 1rem;
      gap: 0.5rem;
    }
    .mode-btn,
    .lang-btn {
      padding: 0.55rem 1rem;
      font-size: 0.8rem;
    }
    /* Stays visible here: it is the primary call to action now, and the old
       rule hid it entirely below this width. */
    .book-link {
      font-size: 0.8rem;
    }
  }
</style>

<script>
  function initToggles() {
    // Language toggle
    const langToggle = document.querySelector<HTMLElement>('.lang-toggle');
    const langButtons = document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]');
    if (langToggle) {
      function setLanguage(lang: string) {
        langToggle!.setAttribute('data-active', lang);
        langButtons.forEach((btn) => {
          btn.setAttribute('aria-selected', String(btn.dataset.langBtn === lang));
        });
        localStorage.setItem('lang', lang);
        document.dispatchEvent(new CustomEvent('language-change', { detail: { lang } }));
      }

      langButtons.forEach((btn) => {
        btn.addEventListener('click', () => setLanguage(btn.dataset.langBtn!));
      });

      // Restore from localStorage or default to 'en'
      const saved = localStorage.getItem('lang') || 'en';
      setLanguage(saved);
    }

    // Mode toggle
    const modeToggle = document.querySelector<HTMLElement>('.mode-toggle');
    const modeButtons = document.querySelectorAll<HTMLButtonElement>('[data-mode-btn]');
    if (!modeToggle) return;

    function setActive(mode: string) {
      modeToggle!.setAttribute('data-active', mode);
      modeButtons.forEach((btn) => {
        btn.setAttribute('aria-selected', String(btn.dataset.modeBtn === mode));
      });
      document.dispatchEvent(new CustomEvent('mode-change', { detail: { mode } }));
    }

    modeButtons.forEach((btn) => {
      btn.addEventListener('click', () => setActive(btn.dataset.modeBtn!));
    });

    setActive('hire');
  }

  initToggles();
</script>
